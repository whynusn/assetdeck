{
  "version": 1,
  "note": "theme-system 自举期的主题令牌声明（声明式夹具）。值必须与 crates/ui-viewmodels/src/theme.rs 的 Provider 逐值一致；Rust 侧主题包系统落地后，preview.mjs 改吃 --tokens 快照，本文件退化为回归对照。",
  "themes": {
    "light": {
      "base": "light",
      "source": "crates/ui-viewmodels/src/theme.rs::LightThemeProvider",
      "globals": {
        "Palette.color-scheme": "light",
        "Theme.bg-app": "#f7f7f8",
        "Theme.bg-panel": "#ffffff",
