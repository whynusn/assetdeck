        "Theme.bg-raised-press": "#e4e4e9",
        "Theme.bg-input": "#ffffff",
        "Theme.line": "#e0e0e6",
        "Theme.line-strong": "#c8c8d0",
        "Theme.text": "#1f2328",
        "Theme.text-2": "#444b52",
        "Theme.text-3": "#62696f",
        "Theme.accent": "#0f6cbd",
        "Theme.accent-hover": "#0a6faa",
        "Theme.accent-press": "#095d90",
        "Theme.accent-ink": "#ffffff",
        "Theme.accent-soft": "#e3f0fc",
        "Theme.danger": "#c0343f",
        "Theme.danger-soft": "#fbe8ea",
        "Theme.danger-press": "#a92d37",
        "Theme.warn": "#805a0b",
        "Theme.warn-soft": "#f8efd9",
