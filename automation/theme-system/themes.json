        "Theme.badge-text": "#ffffff",
        "Theme.badge-ring": "#ffffffcc",
        "Theme.tile-veil": "#ffffffd9",
        "Theme.card-icon": "#62696f"
      }
    },
    "dark": {
      "base": "dark",
      "source": "crates/ui-viewmodels/src/theme.rs::DarkThemeProvider（slint 默认值同源，仅覆盖以显式表达）",
      "globals": {
        "Palette.color-scheme": "dark",
        "Theme.bg-app": "#1c1c1c",
        "Theme.bg-panel": "#202020",
        "Theme.bg-bar": "#252525",
