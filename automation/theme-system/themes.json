        "Theme.control-track-border": "#8a8a8a",
        "Theme.text": "#f4f4f4",
        "Theme.text-2": "#c9c9c9",
        "Theme.text-3": "#a6a6a6",
        "Theme.accent": "#60cdff",
        "Theme.accent-hover": "#7ad7ff",
        "Theme.accent-press": "#4bb2e0",
        "Theme.accent-ink": "#06131a",
        "Theme.accent-soft": "#1f3a47",
        "Theme.danger": "#e4747d",
        "Theme.danger-soft": "#352124",
        "Theme.danger-press": "#2a1c1f",
        "Theme.danger-ink": "#ffffff",
        "Theme.warn": "#e3b457",
        "Theme.warn-soft": "#3a3320",
