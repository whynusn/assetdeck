// 素材管理器主窗：哑渲染——只绑定属性与转发回调，业务逻辑全在 ui-viewmodels。
//
// 配色/圆角/图标一律走 theme.slint 的令牌与字形表；输入框、按钮、进度条用内置
// std-widgets：样式钉在 fluent（常量表层明暗双份），运行时经 Palette.color-scheme
// 与自绘层同步翻转（D37），两层观感一体。
import { Button, LineEdit, ProgressIndicator, ScrollView, Palette, ComboBox } from "std-widgets.slint";
import { Theme, Icon, Glyph, IconButton, DangerButton, FlatButton, SectionLabel, SettingRow, MenuItem } from "theme.slint";
// 把导入的全局再导出一次：Rust 侧经 `ui.global::<Theme>()` 注入运行时主题令牌。
export { Theme } from "theme.slint";
// 显式再导出内置 Palette 全局：std-widgets（fluent 样式）的全部内部颜色都是从
// `Palette.color-scheme` 实时推导的活绑定，Rust 侧拿到句柄后写 color-scheme
// 即可在运行时整体翻转明暗——这是「浅色主题切不全」问题的正解（D37）。
export { Palette }

// UI 共享枚举常量：消灭 .slint 里的魔法数字（综合分析报告「三.9」）。
// 数字值与 app-ui/src/ui_enums.rs 的映射保持一致。
export global UiEnums {
    out property <int> target-mode-empty: 0;
    out property <int> target-mode-ready: 1;
    out property <int> target-mode-needs-confirmation: 2;
    out property <int> target-mode-choose: 3;
    out property <int> notice-tone-success: 0;
    out property <int> notice-tone-warning: 1;
    out property <int> notice-tone-error: 2;
    out property <int> card-kind-image: 0;
    out property <int> card-kind-video: 1;
    out property <int> card-kind-text: 2;
    out property <int> card-kind-other: 3;
    // D48 底部操作条形态：隐藏 / 多选（Normal）/ 回收站视图。
    out property <int> bar-hidden: 0;
    out property <int> bar-multi: 1;
    out property <int> bar-trash: 2;
    // D65 导入结果行形态。
    out property <int> result-row-exact: 0;
    out property <int> result-row-similar: 1;
    out property <int> result-row-failed: 2;
    // D66 归类弹窗：预告行形态（待分类/已有/新建）与「导入」按钮语义
    // （按输入解析 / 直入待分类）。
    out property <int> classify-hint-inbox: 0;
    out property <int> classify-hint-existing: 1;
    out property <int> classify-hint-new: 2;
    out property <int> classify-confirm-resolve: 0;
    out property <int> classify-confirm-inbox: 1;
}

export struct TileData {
    x: length,
    y: length,
    w: length,
    h: length,
    asset-id: int,
    label: string,
    color: color,
    // 浏览用缩略图（离线派生的 <=320px PNG）。缺图时为空 image，露出 color 兜底。
    thumb: image,
    // D53 淡入标志：true = 有图（缓存命中/新装出），false = 缺图占位。
    // false→true 翻转（fill 补齐）播 150ms 淡入；挂载即 true 不重播（滚动/切页）。
    thumb-fade: bool,
    // 素材类别（UiEnums.card-kind-*，与 domain::AssetKind 对齐）：卡片按类别切表现。
    kind: int,
    // 文本类素材的预览（首行若干字符）；其余类别为空串。
    preview: string,
    // D47 选中标记：勾选角标 + accent 描边由它驱动。
    selected: bool,
}

export struct SettingRowData {
    key: string,
    title: string,
    detail: string,
    checked: bool,
    enabled: bool,
    // true = 分区标题行（title 承载组名，如「上框行为」），不渲染开关。
    // 由壳层按 SETTING_SPECS 的 section 字段插入，视图侧不做分组推断。
    header: bool,
}

export struct TargetChoiceData {
    selection-key: string,
    label: string,
    // 别名覆盖前的默认标签（profile · 窗口标题），重命名弹层的标题行回显用。
    default-label: string,
    status: string,
    health-color: color,
    available: bool,
}

// D65 导入结果行：kind = UiEnums.result-row-*（0=完全相同跳过 1=相似已导入
// 2=失败）；source = 导入源文件名；existing = 已有素材名（exact/similar）或
// 失败原因（failed）；distance = 感知距离（仅 similar 行有意义）。
export struct ImportResultRowData {
    kind: int,
    source: string,
    existing: string,
    distance: int,
}

export component AppWindow inherits Window {
    title: "素材管理器";
    // 窗口图标（标题栏/任务栏/Alt-Tab）：路径相对本文件指向仓库根 assets/。
    // Explorer/快捷方式用的 exe 资源图标不在这里，由 build.rs 经 winresource 另嵌。
    icon: @image-url("../../../assets/window-icon.png");
    preferred-width: 1000px;
    preferred-height: 700px;
    background: Theme.bg-app;

    // —— VM 绑定面（由壳层写入/读取）——
    in-out property <length> content-height: 1px;
    in-out property <length> content-y: 0px; // 与 Flickable viewport-y 双向绑定，壳层只读
    out property <length> viewport-height: flick.height;
    out property <length> viewport-width: flick.width;
    in property <[TileData]> tiles;
    in property <string> total-text: "";
    in property <string> filter-label: "全部";
    in property <[string]> categories: ["全部"];
    in property <[int]> category-counts: [];
    // -1 = 全部，-2 = 检索结果态（不高亮任何分类），>=0 = 具体分类号
    in property <int> selected-category: -1;
    in-out property <string> search-text: "";
    // 当前正在使用的素材（最近一次上框），用于在网格里标出焦点。
    in property <int> active-asset-id: -1;
    // 空态文案：由壳层按「库空 / 检索无结果 / 分类为空」分别填。
    in property <string> empty-title: "";
    in property <string> empty-hint: "";
    in property <string> target-label: "点击选择聊天窗口";
    in property <color> target-health-color: #777b80;
    in property <bool> target-pinned: false;
    in property <int> target-mode: 0;
    in property <[TargetChoiceData]> target-choices;
    // 目标实例重命名弹层（右键 picker 行触发）：别名写进 targets.json，
    // chip 与 picker 同步显示；留空保存 = 恢复默认名。
    in property <bool> target-rename-open: false;
    in property <string> target-rename-default: "";
    in-out property <string> target-rename-text: "";
    callback target-rename-requested(string);
    callback target-rename-confirmed(string);
    callback target-rename-cancelled();
    in property <string> notice-text: "";
    in property <int> notice-tone: 0;
    // notice-text 设成 in-out：壳层负责写入提示，视图侧的自动消隐 Timer 与关闭按钮
    // 负责在数秒后或用户点击时把它清空。成功类提示不该常驻占一整行。
    callback notice-dismissed();
    in property <bool> progress-visible: false;
    in property <float> progress-percent: 0.0;
    in property <string> progress-text: "";
    in property <string> clear-button-text: "清空素材库";
    in property <bool> clear-button-armed: false;
    // 设置：描述化模型（key/title/detail/checked）+ 面板开合。
    in property <[SettingRowData]> settings: [];
    in property <bool> single-click-activate: false;
    in property <bool> send-after-paste: false;
    in property <bool> settings-open: false;
    in property <bool> gpu-rendering: false;
    // 界面动画开关（设置面板「界面动画」）：弹层展开的过渡动画时长由此钳到 0。
    in property <bool> animations-enabled: true;
    // 导入菜单（左下角单入口弹层）开合：与 settings-open 同模式，壳层管理。
    in property <bool> import-menu-open: false;
    // 左侧分类侧栏宽度：拖动分隔条实时改，松手经 sidebar-resize-ended 持久化。
    in-out property <length> sidebar-width: 212px;
    // 拖动夹取范围（壳层持久化时用同一组数字，改这里需同步 main.rs 常量）。
    property <length> min-sidebar-width: 150px;
    property <length> max-sidebar-width: 420px;
    // 唤出全量重绘哨兵翻转位：platform::win32::paint_guard 在「系统整窗失效」
    // （最小化恢复/遮挡重现，DWM 已丢窗口表面）时翻转此属性 → repaint-sentinel
    // 的 opacity 绑定变化 → 整窗标脏，逼部分重绘管线画一整帧盖掉黑区。
    in property <bool> repaint-nudge: false;

    // —— D47/D48 选区、菜单与弹窗状态（全部壳层驱动，视图无业务）——
    in property <int> selection-bar: 0; // UiEnums.bar-*
    in property <int> selection-count: 0; // 操作条按钮的可用性：0 选禁用批量动作
    in property <string> selection-text: ""; // 「已选 N 项」/ 0 选时的操作指引
    in property <bool> select-mode-active: false; // 顶栏按钮高亮
    in property <int> trash-count: 0; // 侧栏回收站角标（0 隐藏数字）
    in property <bool> rename-open: false;
    in property <string> rename-current: "";
    in property <string> rename-error: "";
    in property <bool> properties-open: false;
    in property <string> props-name: "";
    in property <string> props-size: "";
    in property <string> props-bytes: "";
    in property <string> props-created: "";
    in property <string> props-path: "";
    // 清空回收站的二段确认（与「清空素材库」DangerButton 同模式）。
    in property <bool> empty-trash-armed: false;
    in property <string> empty-trash-text: "清空回收站";
    // 「移动到分类」弹层：现有分类 + 「待分类」兜底项 + 新名输入框。
    in property <bool> move-menu-open: false;
    in property <string> move-error: "";

    // —— D66 导入归类弹窗（批次级：整批一个决策） ——
    // open 挂载 / shown 是入场动效翻转位：壳层在 open 置位后的下一帧再置
    // shown（D53 结论：init 技巧无效，首帧前翻转不会触发过渡）；出场两段式
    // 由壳层先收 shown 播完 150ms 再收 open。
    in property <bool> classify-open: false;
    in property <bool> classify-shown: false;
    // 只读来源清单行 + 单输入框状态（候选由壳层过滤封顶）。
    in property <string> classify-summary;
    in property <string> classify-argument;
    in property <[string]> classify-matches;
    // 实时预告行：输入框当前内容将导向哪类结果（UiEnums.classify-hint-*）。
    in property <string> classify-hint;
    in property <int> classify-hint-kind: 0;
    // probe 结果转接（子进程线程只许 Weak<AppWindow>，计数经回调回 UI 线程；
    // count -1 = none；finished 不带数据只做归零计数）。
    callback classify-probe-result(string, int);
    callback classify-probe-finished();
    // 输入同步（壳层重滤候选并刷新预告行）。
    callback classify-name-changed(string);
    // 候选点选 = 用列表规范名回填输入框。
    callback classify-picked(string);
    callback classify-canceled();
    // kind = UiEnums.classify-confirm-*：0 按输入解析（归入/新建）1 直入待分类。
    callback classify-confirmed(int);

    // —— D65 导入结果弹窗 ——
    // 去重/相似/失败的持久点名面板：瞬时通知条会自动消隐，而「素材去哪了」
    // 的结论必须可停留、可逐项核对（去重感知红线）。open/shown 两段式同
    // classify；明细行由壳层从子进程 RESULTITEM 协议行收集。
    in property <bool> import-result-open: false;
    in property <bool> import-result-shown: false;
    in property <string> import-result-summary: "";
    in property <[ImportResultRowData]> import-result-rows;
    callback import-result-closed();

    // —— 回调转发（无业务逻辑）——
    callback scroll-changed(length);
    callback viewport-resized();
    callback double-clicked(int);
    callback tile-clicked(int);
    // D47 选区交互：瓦片 pointer-event 拆件（up 左键带修饰 = tile-modified-click；
    // up 右键 = tile-right-click 带瓦片绝对坐标供菜单定位）。坐标是窗口逻辑像素。
    callback tile-modified-click(int, bool, bool);
    // 顶栏「选择」按钮 / 操作条「取消」/ Esc 共用的模式开关（壳层判方向）。
    callback select-mode-toggled();
    // 操作条动作：全选 / 移动到分类 / 删除 / 恢复 / 彻底删除 / 清空回收站。
    callback select-all-requested();
    callback move-selection-requested();
    callback delete-selection-requested();
    // 库写子命令（trash/restore/purge/empty-trash/rename/move-category）收尾信号：
    // 子进程线程只能持 Weak，收尾一律经本回调弹回 UI 线程处理（同 export-finished 模式）。
    callback libcmd-finished(bool, string, string);
    callback restore-selection-requested();
    callback purge-selection-requested();
    callback empty-trash-requested();
    // 菜单动作回传（id 编码 0=复制..4=删除，与 selection::MenuAction 对齐）；
    // 移动到分类的两级目的地（现有分类名或新名，壳层校验）。
    callback tile-right-click(int, length, length);
    in property <bool> context-menu-open: false;
    in property <length> context-menu-x: 0px;
    in property <length> context-menu-y: 0px;
    in property <string> context-menu-title: ""; // 目标摘要（「3 项」或文件名）
    callback menu-action(int);
    callback move-to-category(string);
    callback context-menu-dismissed();
    // 重命名弹窗确认（新名；壳层 trim 校验非空/无路径分隔）与取消。
    callback rename-confirmed(string);
    callback rename-canceled();
    callback properties-folder-requested();
    callback properties-closed();
    // Ctrl+A / Esc 键盘通道：FocusScope 捕获后转发，业务判定在壳层。
    callback key-a-pressed();
    callback escape-pressed();
    // 启动时给 key-root 上焦：Slint 不为子元素生成 get_* 访问器，聚焦只能
    // 在 .slint 内自理（Rust 侧 invoke，处理器里调元素方法）。
    callback key-focus-requested();
    key-focus-requested => { key-root.focus(); }
    callback filter-selected(int); // -1 = 全部，-2 = 检索结果态，-3 = 回收站，其余为分类号
    callback search-changed(string);
    callback target-chip-clicked();
    callback target-choice-selected(string);
    callback target-pin-toggled();
    callback settings-toggled();
    // D67 设置面板显式关闭（点外部不再收起——见挡板注释）。
    callback settings-closed();
    callback setting-toggled(string);
    callback overlay-dismissed();
    callback import-requested();
    // D49 主导入：文件对话框多选（素材 + .emo 混选）。
    callback import-files-requested();

    // —— D51 搜索范围下拉 ——
    // scope: 0=全部 1=文件名 2=分类 3=标签（UiEnums 收口，D32 纪律）。
    in property <int> search-scope: 0;
    in property <bool> scope-menu-open: false;
    in property <bool> scope-menu-shown: false; // 两段式动效翻转位（同 classify）

    // —— D53 旧三弹层入场修复（init 技巧无效 → init 只报数，Rust 下帧翻转）。
    // 出场维持现状（即时卸载）：目标下拉的关闭由轮询驱动的 sync_target_bar
    // 拍板，两段式卸载会与轮询状态机竞态——差异走查记 design §1。
    in property <bool> target-picker-shown: false;
    in property <bool> import-menu-shown: false;
    in property <bool> settings-shown: false;
    // which: 0=目标下拉 1=导入菜单 2=设置面板。
    callback overlay-mounted(int);
    callback scope-menu-toggled();
    callback scope-selected(int);
    // OS 拖入文件（IDropTarget 兜底，platform::win32::dragdrop 注册）：
    // 路径列表进同一归类弹窗；不支持类型由 VM 过滤（R4）。
    callback files-dropped([string]);
    callback import-menu-toggled();
    callback sidebar-resize-ended(length);
    callback clear-library-requested();
    callback export-emo-requested();
    callback export-progress(int, int);
    callback export-finished(bool, string);
    callback poll-targets();
    callback thumbnails-generated();
    callback thumbnail-progress(int, int);
    callback import-progress(int, int);
    callback import-finished(bool, string);
    // D38：设置面板底部「打开日志目录」。
    callback open-logs-requested();

    // —— D61 旧版库一键迁移 ——
    // 仅在检测到 exe 旁遗留库（或未收账的迁移备份）时出现于设置面板；
    // detail 是检测文案（文件数/体量），busy 期间按钮禁用（与导入互斥）。
    in property <bool> migrate-legacy-available: false;
    // D64 已完成态：旧库已全部收账时迁移区不隐身——展示留档位置供找回。
    in property <bool> migrate-legacy-done: false;
    in property <string> migrate-legacy-backup-path: "";
    in property <string> migrate-legacy-detail: "";
    in property <bool> migrate-legacy-busy: false;
    callback migrate-legacy-requested();
    callback open-migration-backup-requested();

    // —— D56 更新检查 ——
    // app-version 是壳层注入的当前版本（"v0.1.0"）；status-text 是设置面板
    // 「关于」区状态行（danger 决定是否着错误色）；badge 是设置齿轮上的
    // 未处理更新点。弹窗 open/shown 两段式（同 classify），内容由壳层回填。
    in property <string> app-version: "";
    in property <bool> update-checking: false;
    in property <string> update-status-text: "";
    in property <bool> update-status-danger: false;
    in property <bool> update-badge: false;
    in property <bool> update-open: false;
    in property <bool> update-shown: false;
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <string> update-url: "";
    callback update-check-requested();
    callback update-open-release-page();
    callback update-later();
    callback update-skip-version();

    // 目标条右侧提示：讲「现在能不能上框、下一步该点哪里」，不说内部状态名
    // （旧文案「就绪/需确认/未选择目标」与 chip 的「未识别目标」三词一义，
    // 用户无从对应）。每档都落在一个可执行的下一步上。
    property <string> target-hint: root.target-mode == UiEnums.target-mode-ready
        ? "就绪 · 双击素材即可上框"
        : root.target-mode == UiEnums.target-mode-needs-confirmation
            ? "通用目标 · 首次上框需确认"
            : root.target-mode == UiEnums.target-mode-choose
                ? "点选列表中的聊天窗口"
                : "选择聊天窗口后，双击素材即可上框";

    changed content-y => {
        root.scroll-changed(root.content-y);
    }

    changed viewport-height => {
        root.viewport-resized();
    }

    changed viewport-width => {
        root.viewport-resized();
    }

    // overlay 宿主：填满窗口。内层先放常规布局，再叠绝对定位浮层。
    // D47 键盘通道：根 FocusScope 兜住 Esc（关菜单/弹窗/退多选）与 Ctrl+A
    // （全选当前视图）。capture 阶段父先于子：检索框/输入框编辑时让路，
    // Ctrl+A 不误伤文本全选。壳层启动时 focus() 一次（见 main.rs）。
    key-root := FocusScope {
        focus-on-click: false;

        capture_key_pressed(event) => {
            // Ctrl+A：仅在没有任何文本输入持焦时截获（否则留给输入框全选文本）。
            if (event.modifiers.control && (event.text == "a" || event.text == "A")
                && !search-input.has-focus) {
                root.key-a-pressed();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.escape-pressed();
                return accept;
            }
            return reject;
        }

        Rectangle {
        // FocusScope 不是 Window，子元素不会被自动拉伸：显式铺满。
        // （外层 Rectangle 的「勿写 100%」告诫只针对 Window 根——那会反向
        // 钳制窗口可拖尺寸；这里几何由 FocusScope 决定，100% 是安全的。）
        width: 100%;
        height: 100%;

        // 全量重绘哨兵：垫在所有内容之下，透明无 TouchArea（不参与布局、
        // 不挡输入）。repaint-nudge 翻转带动 opacity 变化；Opacity 类项在
        // 脏区计算里命中「变化即刷新整棵子树」分支（partial_renderer.rs
        // must_refresh_children），故其自身几何 = 全窗 ⇒ 一帧全量重绘。
        // 两档透明度差 0.1%，肉眼不可感知。
        Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;
            opacity: root.repaint-nudge ? 1.0 : 0.999;
        }

        VerticalLayout {
            // 顶部工具栏：标题/总数 + 检索器 + 设置入口。
            // 不写 alignment:start：默认 stretch 下弹性占位才能吃掉剩余宽度，
            // 把检索器/设置推到最右（alignment:start 会把所有元素压到左半边）。
            Rectangle {
                height: 48px;
                background: Theme.bg-bar;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Glyph.layers;
                        tint: Theme.accent;
                        width: 18px;
                        height: 18px;
                    }

                    // 顶栏不再重复窗口标题「素材管理器」，改成当前库视图的读数：
                    // 「共 N 项」为主，当前分类/检索范围为次，一眼看清「现在在看什么」。
                    // 视图标签做成 chip（描边胶囊）：与计数是两类信息（多少 vs 在哪看），
                    // 黏排会被误读成一句话（「共 10 项全部」）。
                    Text {
                        text: root.total-text;
                        vertical-alignment: center;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }

                    view-chip := Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: Theme.line;
                        background: Theme.bg-raised;
                        width: Math.min(view-chip-text.preferred-width + 16px, 280px);

                        view-chip-text := Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: root.filter-label;
                            vertical-alignment: center;
                            color: Theme.text-2;
                            font-size: 11px;
                            overflow: elide;
                        }

                        Tooltip {
                            text: @markdown("当前视图：分类、回收站或检索结果");
                        }
                    }

                    // 弹性占位，把检索器与设置推到最右。
                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // D47 顶栏「选择」：进入/退出多选模式的显式入口。
                    select-anchor := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 62px;
                        height: 30px;

                        select-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.select-mode-toggled();
                            }
                        }

                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: root.select-mode-active ? Theme.accent
                                : select-touch.has-hover ? Theme.line-strong : Theme.line;
                            background: root.select-mode-active ? Theme.accent-soft
                                : select-touch.pressed ? Theme.bg-raised-press
                                : select-touch.has-hover ? Theme.bg-raised-hover : Theme.bg-raised;
                            animate background, border-color { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    commands: root.select-mode-active ? Glyph.close : Glyph.check;
                                    tint: root.select-mode-active ? Theme.accent : Theme.text-2;
                                    width: 12px;
                                    height: 12px;
                                }
                                select-label := Text {
                                    text: root.select-mode-active ? "取消" : "选择";
                                    color: root.select-mode-active ? Theme.accent : Theme.text-2;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Tooltip {
                            text: @markdown("多选模式：期间单击=选中/取消，上框动作屏蔽（Esc 退出）");
                        }
                    }

                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Glyph.search;
                        tint: search-input.has-focus ? Theme.accent : Theme.text-3;
                        width: 15px;
                        height: 15px;
                    }

                    // D51 范围 chip：点击弹四选一菜单（壳层缓存查询，切档即重跑）。
                    scope-anchor := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: scope-chip.preferred-width + 24px;
                        height: 30px;

                        scope-chip := Rectangle {
                            x: (parent.width - self.preferred-width) / 2;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: root.scope-menu-open ? Theme.accent : Theme.line;
                            background: root.scope-menu-open ? Theme.accent-soft : Theme.bg-input;
                            preferred-width: scope-text.preferred-width + 26px;
                            height: parent.height;

                            chev := Icon {
                                x: self.preferred-width - 14px;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                commands: Glyph.chevron-down;
                                tint: Theme.text-3;
                            }
                            scope-text := Text {
                                x: 8px;
                                text: root.search-scope == 1 ? "文件名"
                                    : root.search-scope == 2 ? "分类"
                                    : root.search-scope == 3 ? "标签"
                                    : "全部";
                                color: root.scope-menu-open ? Theme.accent : Theme.text-2;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.scope-menu-toggled(); }
                            }
                        }
                        Tooltip {
                            text: @markdown("搜索范围：全部=名称+分类+标签；其余档位只搜对应名称");
                        }
                    }

                    // 检索器：对分类名/标签名做模糊匹配。高度必须显式钉 30px——
                    // 不钉会被 HorizontalLayout 纵向拉满整行（48px），比同排控件
                    // 高一圈还顶进标题栏（真机截图教训）；宽度自适应 150–320px，
                    // 窄窗口先压缩检索框而不是互相叠压。
                    search-input := LineEdit {
                        y: (parent.height - self.height) / 2;
                        height: 30px;
                        min-width: 150px;
                        max-width: 320px;
                        horizontal-stretch: 1;
                        placeholder-text: root.search-scope == 1 ? "搜索文件名"
                            : root.search-scope == 2 ? "搜索分类名"
                            : root.search-scope == 3 ? "搜索标签名"
                            : "搜索名称、分类或标签";
                        text <=> root.search-text;
                        edited(value) => {
                            root.search-changed(value);
                        }
                    }

                    settings-anchor := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 30px;
                        height: 30px;

                        IconButton {
                            glyph: Glyph.sliders;
                            tip: "设置：上框触发方式、发送行为、渲染后端";
                            active: root.settings-open;
                            clicked => {
                                root.settings-toggled();
                            }
                        }

                        // D56 未处理更新角标：红点压齿轮右上角，开面板看详情。
                        // 8px 是「余光可辨」的下限——再小就在高亮描边旁隐身了。
                        if root.update-badge: Rectangle {
                            x: parent.width - 9px;
                            y: 1px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.danger;
                            border-width: 1px;
                            border-color: Theme.bg-bar;
                        }
                    }
                }
            }

            // 目标条：当前目标始终可见；点击 chip 展开垂直下拉浮层（不下推布局）。
            // 左簇=操作件（标签/chip/锁定），右簇=就绪说明（右对齐），整行左右平衡。
            Rectangle {
                height: 52px;
                background: Theme.bg-panel;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;

                    SectionLabel {
                        text: "上框目标";
                    }

                    target-chip := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 268px;
                        height: 30px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: root.target-mode == UiEnums.target-mode-choose ? Theme.accent
                            : chip-touch.has-hover ? Theme.line-strong
                            : Theme.line;
                        background: chip-touch.pressed ? Theme.bg-raised-press
                            : chip-touch.has-hover ? Theme.bg-raised-hover
                            : Theme.bg-raised;

                        animate background, border-color { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.target-health-color;
                            }

                            Text {
                                text: root.target-label;
                                horizontal-stretch: 1;
                                color: Theme.text;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Icon {
                                y: (parent.height - self.height) / 2;
                                commands: root.target-mode == UiEnums.target-mode-choose ? Glyph.chevron-up : Glyph.chevron-down;
                                tint: Theme.text-3;
                                width: 14px;
                                height: 14px;
                            }
                        }

                        chip-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.target-chip-clicked();
                            }
                        }

                        Tooltip {
                            text: @markdown("切换上框目标窗口");
                        }
                    }

                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 30px;
                        height: 30px;

                        IconButton {
                            glyph: root.target-pinned ? Glyph.lock : Glyph.unlock;
                            tip: root.target-pinned
                                ? "已锁定：只上框到这个窗口，不随前台切换"
                                : "未锁定：自动跟随最近使用的 IM 窗口";
                            active: root.target-pinned;
                            // 还没选目标时锁定无意义，禁用以免用户误以为锁了个空目标。
                            enabled: root.target-mode != UiEnums.target-mode-empty;
                            clicked => {
                                root.target-pin-toggled();
                            }
                        }
                    }

                    // 说明文案占满剩余宽度并右对齐：不再挤在 chip 旁边。
                    Text {
                        text: root.target-hint;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 1;
                        color: Theme.text-3;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }

            if root.notice-text != "": Rectangle {
                height: 34px;
                background: root.notice-tone == UiEnums.notice-tone-error ? Theme.danger-soft
                    : root.notice-tone == UiEnums.notice-tone-warning ? Theme.warn-soft
                    : Theme.ok-soft;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: root.notice-tone == UiEnums.notice-tone-error ? Glyph.ban
                            : root.notice-tone == UiEnums.notice-tone-warning ? Glyph.alert
                            : Glyph.check;
                        tint: root.notice-tone == UiEnums.notice-tone-error ? Theme.danger
                            : root.notice-tone == UiEnums.notice-tone-warning ? Theme.warn
                            : Theme.accent;
                        width: 14px;
                        height: 14px;
                    }

                    Text {
                        text: root.notice-text;
                        horizontal-stretch: 1;
                        color: Theme.text;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // 关闭提示：成功类提示会自动消隐，这里再给用户一个随时收起的入口，
                    // 避免一整行长期占用纵向空间。做成轻量的无边框图标，融进色条里。
                    notice-close := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 22px;
                        height: 22px;
                        border-radius: Theme.radius;
                        background: notice-close-touch.has-hover ? Theme.bg-raised-hover : transparent;
                        animate background { duration: 100ms; }

                        Icon {
                            commands: Glyph.close;
                            tint: Theme.text-2;
                            width: 12px;
                            height: 12px;
                        }

                        notice-close-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.notice-dismissed();
                            }
                        }

                        Tooltip {
                            text: @markdown("收起这条提示");
                        }
                    }
                }
            }

            if root.progress-visible: Rectangle {
                height: 32px;
                background: Theme.bg-panel;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    alignment: start;

                    ProgressIndicator {
                        y: (parent.height - self.height) / 2;
                        width: 200px;
                        height: 4px;
                        progress: root.progress-percent;
                    }

                    Text {
                        text: root.progress-text;
                        color: Theme.text-2;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // 主体：左分类侧栏 + 中央瀑布流网格（参考千牛「我的表情」排版）。
            HorizontalLayout {
                // 这一行吃掉窗口的全部剩余高度：其余行都是固定高，若此行不显式拉伸，
                // 顶层 VerticalLayout 的最大高度会被算成各行之和（有限值），
                // Windows 便据此把窗口最大可拖高度钳在内容高度上，导致纵向拉不动。
                vertical-stretch: 1;
                // 交叉轴（垂直）max 会取子项 max 的最小值；子项里若有有限 max，会把
                // 整窗最大可拖高度钳在内容高度上。显式抬高本行的 max-height，解除该钳制。
                max-height: 100000px;
                // 左侧分类侧栏（垂直列表 + 底部素材库维护）。
                // 宽度可拖（150–420px）：实时值在 sidebar-width，松手持久化。
                Rectangle {
                    width: Math.min(root.max-sidebar-width, Math.max(root.min-sidebar-width, root.sidebar-width));
                    background: Theme.bg-panel;

                    VerticalLayout {
                        SectionLabel {
                            x: 14px;
                            height: 28px;
                            text: "分类";
                        }

                        // 分类列表：可滚动。
                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.visible-width;
                            viewport-height: cat-list.preferred-height;

                            cat-list := VerticalLayout {
                                padding-bottom: 8px;

                                for name[i] in root.categories: Rectangle {
                                    height: 36px;
                                    background: (i - 1) == root.selected-category ? Theme.accent-soft
                                        : (cat-touch.has-hover ? Theme.bg-raised : transparent);

                                    animate background { duration: 100ms; }

                                    // 选中态左侧强调条。
                                    Rectangle {
                                        x: 0;
                                        width: 3px;
                                        height: parent.height;
                                        background: (i - 1) == root.selected-category ? Theme.accent : transparent;
                                    }

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 12px;
                                        spacing: 6px;

                                        Text {
                                            text: name;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            color: (i - 1) == root.selected-category ? Theme.text : Theme.text-2;
                                            font-size: 12px;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: i < root.category-counts.length ? root.category-counts[i] : "";
                                            vertical-alignment: center;
                                            color: Theme.text-3;
                                            font-size: 10px;
                                        }
                                    }

                                    cat-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.filter-selected(i - 1);
                                        }
                                    }
                                }
                            }
                        }

                        // D46 回收站入口（侧栏系统分类项）：选中 = 专用 Trash 视图。
                        Rectangle {
                            height: 36px;
                            background: root.selected-category == -3 ? Theme.accent-soft
                                : (trash-touch.has-hover ? Theme.bg-raised : transparent);
                            animate background { duration: 100ms; }

                            Rectangle {
                                x: 0;
                                width: 3px;
                                height: parent.height;
                                background: root.selected-category == -3 ? Theme.accent : transparent;
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                spacing: 6px;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    commands: Glyph.trash;
                                    tint: root.selected-category == -3 ? Theme.accent : Theme.text-3;
                                    width: 13px;
                                    height: 13px;
                                }

                                Text {
                                    text: "回收站";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    color: root.selected-category == -3 ? Theme.text : Theme.text-2;
                                    font-size: 12px;
                                }

                                Text {
                                    text: root.trash-count > 0 ? root.trash-count : "";
                                    vertical-alignment: center;
                                    color: Theme.text-3;
                                    font-size: 10px;
                                }
                            }

                            trash-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.filter-selected(-3);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.line;
                        }

                        // 素材库维护区：导入目录 / 导出 / 清空。
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            SectionLabel {
                                height: 18px;
                                text: "素材库";
                            }

                            // 导入单入口：一个按钮弹出菜单，按来源二选一「文件 / 文件夹」。
                            // 两类来源走不同原生对话框（文件选择器选不了目录），菜单
                            // 选中后仍走同一条子进程导入管线（D11/D24 包注册表按扩展名
                            // 分发；.emo 素材包从文件入口混选，不再单列）。
                            import-anchor := Rectangle {
                                height: 30px;

                                Button {
                                    width: 100%;
                                    height: 100%;
                                    text: "导入素材…";
                                    primary: true;
                                    clicked => {
                                        root.import-menu-toggled();
                                    }
                                }
                            }

                            // 高度必须显式钉死：裸 std Button 会参与纵向布局的
                            // 剩余空间分配，被拉成一百多 px 的高块（渲染实测）。
                            Button {
                                height: 30px;
                                text: "导出为 .emo…";
                                clicked => {
                                    root.export-emo-requested();
                                }
                            }

                            // 危险隔离线：清空素材库是不可逆操作，与常规导入/导出
                            // 拉开一组，降低顺手误触（与回收站清空同款二段确认兜底）。
                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            // armed：壳层把文案改成确认提示时，按钮转为实心红。
                            DangerButton {
                                text: root.clear-button-text;
                                armed: root.clear-button-armed;
                                clicked => {
                                    root.clear-library-requested();
                                }
                            }
                        }
                    }
                }

                // 拖宽分隔条：按住左右拖调整分类侧栏宽度，松手发 sidebar-resize-ended。
                Rectangle {
                    width: 8px;

                    divider-line := Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: divider-touch.pressed || divider-touch.has-hover ? 2px : 1px;
                        height: parent.height;
                        background: divider-touch.pressed ? Theme.accent
                            : divider-touch.has-hover ? Theme.line-strong
                            : Theme.line;

                        animate width, background { duration: 100ms; }
                    }

                    divider-touch := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        property <length> press-x: 0px;
                        property <length> start-width: 0px;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                press-x = self.mouse-x;
                                start-width = root.sidebar-width;
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.sidebar-resize-ended(root.sidebar-width);
                            }
                        }

                        moved => {
                            root.sidebar-width = Math.min(root.max-sidebar-width,
                                Math.max(root.min-sidebar-width,
                                    start-width + self.mouse-x - press-x));
                        }
                    }

                    Tooltip {
                        text: @markdown("拖动调整分类栏宽度");
                    }
                }

                // 中央虚拟化网格：Flickable + 绝对定位瓦片。
                flick := Flickable {
                    horizontal-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: Math.max(root.content-height, self.height);
                    viewport-y <=> root.content-y;

                    Rectangle {
                        width: flick.viewport-width;
                        height: flick.viewport-height;

                        // 按类别切卡片表现（ImageCard / TextCard / VideoCard 合体）：
                        // - image/video：缩略图铺满（video 额外画右上角徽标）；
                        // - text：中央图标 + 首行预览，不依赖缩略图产物；
                        // - other：中央图标，占位色块可辨识。
                        for tile in root.tiles: Rectangle {
                            x: tile.x;
                            y: tile.y;
                            width: tile.w;
                            height: tile.h;
                            background: tile.color;
                            border-radius: Theme.radius-lg;
                            clip: true;

                            // 图像/视频：缩略图铺满（视频抽帧也走同一产物）。
                            if tile.kind == UiEnums.card-kind-image || tile.kind == UiEnums.card-kind-video: Image {
                                width: 100%;
                                height: 100%;
                                source: tile.thumb;
                                image-fit: cover;
                                // D53 瓦片淡入：缺图补齐时 thumb-fade 翻转播淡入；
                                // 挂载即有图（缓存命中）时初值就是 1，不重播。
                                opacity: tile.thumb-fade ? 1.0 : 0.0;
                                animate opacity {
                                    duration: root.animations-enabled ? 150ms : 0ms;
                                    easing: ease-out;
                                }
                            }

                            // 文本：中央图标 + 首行预览（文本素材从此可辨识，不再只是色块）。
                            if tile.kind == UiEnums.card-kind-text: VerticalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                alignment: center;
                                spacing: 6px;

                                Icon {
                                    commands: Glyph.file-text;
                                    tint: Theme.card-icon;
                                    width: 28px;
                                    height: 28px;
                                }

                                Text {
                                    text: tile.preview;
                                    horizontal-alignment: center;
                                    color: Theme.text-2;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                }
                            }

                            // 其他（归档/未知）：中央图标占位，仍可点选上框（Files 兜底）。
                            if tile.kind == UiEnums.card-kind-other: Rectangle {
                                width: 100%;
                                height: 100%;

                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Glyph.file;
                                    tint: Theme.card-icon;
                                    width: 28px;
                                    height: 28px;
                                }
                            }

                            // 右上角类型徽标：小胶囊 + 类别图标，图片/视频/文本/文件四类
                            // 统一示意。旧版是全宽透明文字横条——遮缩略图、图片类缺失，
                            // 且胶囊宽度没钉死会撑满整卡（本条即那次回归的修复）。
                            // 图形直接按 kind 从 Glyph 表取（字符串名传不进 Path，
                            // kind 与图形本就一一对应，无须经 Rust 再转一道）。
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                x: parent.width - self.width - 6px;
                                y: 6px;
                                border-radius: 7px;
                                background: Theme.badge-bg;

                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: tile.kind == UiEnums.card-kind-image ? Glyph.image
                                        : tile.kind == UiEnums.card-kind-video ? Glyph.film
                                        : tile.kind == UiEnums.card-kind-text ? Glyph.file-text
                                        : Glyph.file;
                                    tint: Theme.badge-text;
                                    width: 13px;
                                    height: 13px;
                                }
                            }

                            // 名称条：贴底整条，hover 时压深底色让长名字更好读。
                            if tile.label != "": Rectangle {
                                y: parent.height - self.height;
                                width: 100%;
                                height: 20px;
                                background: tile-touch.has-hover ? Theme.label-bar-bg-hover : Theme.label-bar-bg;

                                Text {
                                    x: 6px;
                                    width: parent.width - 12px;
                                    text: tile.label;
                                    color: Theme.label-bar-text;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            // 边框覆盖层：hover 描一圈淡边，选中描 accent（多选/回收站勾选态），
                            // 最近上框的那张描 accent。选中优先于 hover。
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: transparent;
                                border-radius: Theme.radius-lg;
                                border-width: tile.selected || tile.asset-id == root.active-asset-id ? 2px
                                    : tile-touch.has-hover ? 1px
                                    : 0px;
                                border-color: tile.selected || tile.asset-id == root.active-asset-id
                                    ? Theme.accent
                                    : Theme.line-strong;
                            }

                            // 左上勾选角标：选中即现（多选模式与常态 Ctrl 选共用）。
                            if tile.selected: Rectangle {
                                x: 6px;
                                y: 6px;
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: Theme.accent;

                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Glyph.check;
                                    tint: white;
                                    width: 12px;
                                    height: 12px;
                                }
                            }

                            tile-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                // D47：按下的那一刻就按住修饰键 → 本次抬笔的
                                // clicked/double-clicked（上框链路）整体作废。
                                // 判定点在 Down（clicked 先于 Up 的 pointer-event 触发，
                                // 事后挡不住）。无修饰路径 mod-on-down 恒 false，
                                // 上框信号逐字照发（红线 B：现状不变）。
                                property <bool> mod-on-down: false;

                                clicked => {
                                    if (!self.mod-on-down) {
                                        root.tile-clicked(tile.asset-id);
                                    }
                                }
                                double-clicked => {
                                    if (!self.mod-on-down) {
                                        root.double-clicked(tile.asset-id);
                                    }
                                }
                                // D47/D48：带修饰的左键抬笔走 modified-click、右键抬笔
                                // 走 right-click；无修饰左键仍由 clicked/double-clicked
                                // 承载（常态上框链路一字不动）。多选模式的普通单击
                                // 由壳层在 tile-clicked 路径里判模式改走选区切换。
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        self.mod-on-down = event.modifiers.control || event.modifiers.shift;
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                                        root.tile-right-click(tile.asset-id,
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                        self.mod-on-down = false;
                                        if (event.modifiers.control || event.modifiers.shift) {
                                            root.tile-modified-click(tile.asset-id,
                                                event.modifiers.control, event.modifiers.shift);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // —— 浮层区（绝对定位，浮于瀑布流之上，不占垂直布局流）——

        // 空态：网格没有瓦片时，锚在网格区域中央说明「为什么空、下一步做什么」。
        if root.tiles.length == 0 && root.empty-title != "": Rectangle {
            x: flick.absolute-position.x;
            y: flick.absolute-position.y;
            width: flick.width;
            height: flick.height;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                Icon {
                    x: (parent.width - self.width) / 2;
                    commands: Glyph.empty-box;
                    tint: Theme.line-strong;
                    width: 44px;
                    height: 44px;
                }

                Text {
                    text: root.empty-title;
                    horizontal-alignment: center;
                    color: Theme.text-2;
                    font-size: 13px;
                }

                Text {
                    text: root.empty-hint;
                    horizontal-alignment: center;
                    color: Theme.text-3;
                    font-size: 11px;
                }
            }
        }

        // 浮层挡板：任一浮层打开时铺满窗口拦截背景点击（工作流弹窗下 =
        // 模态死点击，底下控件收不到；点在弹窗面板自身空白处命中挡板同理，
        // 也不触发收起）。D67 分级收口：壳层在 overlay-dismissed 里只关
        // 菜单级浮层（右键/范围/导入/移动/目标选择器）；设置/归类/重命名/
        // 属性/目标重命名/更新不再吃 dismiss——误触背景不丢输入，关闭走
        // 各自的显式按钮与 Esc。挡板不能摘：摘了背景控件恢复收点，弹窗
        // 飘着时点瓦片会误触发动作，比误关更糟。
        if root.settings-open || root.import-menu-open
            || root.target-mode == UiEnums.target-mode-choose
            || root.context-menu-open || root.move-menu-open
            || root.rename-open || root.properties-open
            || root.scope-menu-open || root.classify-open
            || root.target-rename-open
            || root.update-open: TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.overlay-dismissed();
            }
        }

        // IM 目标垂直下拉：锚定在目标 chip 下方。
        // 展开动画：元素挂载后 init 置 shown，opacity/y 从初始态过渡到位
        //（框架 animate，非手绘）。关闭端是 if 销毁、Slint 即时移除，无出场过渡；
        // 动画时长受「界面动画」设置钳制，关了就 0ms 直达。
        if root.target-mode == UiEnums.target-mode-choose: Rectangle {
            property <bool> shown: root.target-picker-shown;
            init => {
                root.overlay-mounted(0);
            }

            opacity: shown ? 1.0 : 0.0;
            x: target-chip.absolute-position.x;
            y: target-chip.absolute-position.y + target-chip.height + 6px + (shown ? 0px : -6px);
            width: 300px;
            height: choices-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: root.animations-enabled ? 150ms : 0ms; easing: ease-out; }

            choices-layout := VerticalLayout {
                padding: 6px;
                spacing: 4px;

                if root.target-choices.length == 0: Rectangle {
                    height: 56px;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: "没有检测到运行中的聊天窗口";
                            color: Theme.text-2;
                            font-size: 12px;
                        }

                        Text {
                            text: "先打开并登录一个聊天窗口，再回来选择";
                            color: Theme.text-3;
                            font-size: 10px;
                        }
                    }
                }

                for choice in root.target-choices: Rectangle {
                    height: 48px;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: choice-touch.has-hover && choice.available ? Theme.accent : Theme.line;
                    background: choice-touch.pressed ? Theme.bg-raised-press
                        : choice-touch.has-hover ? Theme.bg-raised-hover
                        : Theme.bg-raised;
                    opacity: choice.available ? 1.0 : 0.6;

                    animate background, border-color { duration: 100ms; }

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 3px;

                        HorizontalLayout {
                            spacing: 7px;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: choice.health-color;
                            }

                            Text {
                                text: choice.label;
                                horizontal-stretch: 1;
                                color: Theme.text;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: choice.status;
                            color: Theme.text-3;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }

                    choice-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.target-choice-selected(choice.selection-key);
                        }
                        // 右键 = 重命名该实例（D59 别名册的 UI 入口）。判定在 Down，
                        // 与左键 clicked（Up）互不干扰。
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right
                                && event.kind == PointerEventKind.down {
                                root.target-rename-requested(choice.selection-key);
                            }
                        }
                    }
                }
            }
        }

        // 目标实例重命名：别名写进 targets.json，chip 与 picker 同步显示。
        // 留空保存 = 恢复默认名（默认名回显在标题行）。
        if root.target-rename-open: Rectangle {
            x: (root.width - 340px) / 2;
            y: 150px;
            width: 340px;
            height: target-rename-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            target-rename-layout := VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: "重命名目标窗口";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }

                Text {
                    text: root.target-rename-default;
                    color: Theme.text-3;
                    font-size: 10px;
                    overflow: elide;
                }

                target-rename-input := LineEdit {
                    text: root.target-rename-text;
                    placeholder-text: "别名（留空保存 = 恢复默认名）";
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "取消";
                        clicked => {
                            root.target-rename-cancelled();
                        }
                    }
                    Button {
                        text: "保存";
                        primary: true;
                        clicked => {
                            root.target-rename-confirmed(target-rename-input.text);
                        }
                    }
                }
            }
        }

        // 导入菜单：左下角「导入素材…」上方弹出（向上避免越过窗口底缘）。
        if root.import-menu-open: Rectangle {
            property <bool> shown: root.import-menu-shown;
            init => {
                root.overlay-mounted(1);
            }

            opacity: shown ? 1.0 : 0.0;
            x: import-anchor.absolute-position.x;
            y: import-anchor.absolute-position.y - self.height - 8px + (shown ? 0px : 6px);
            width: 244px;
            height: import-menu-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: root.animations-enabled ? 150ms : 0ms; easing: ease-out; }

            import-menu-layout := VerticalLayout {
                padding: 6px;
                spacing: 4px;

                // 命名与「导入素材…」按钮错开：按钮是入口（弹本菜单），两项按
                // 来源命名（文件/文件夹）。.emo 不再单列：文件入口本就混选
                // .emo 素材包（D49），单独入口是与它语义重复的 D34 遗留。
                MenuItem {
                    glyph: Glyph.import;
                    text: "从文件导入…";
                    detail: "混选图片、视频、文本与 .emo 素材包";
                    clicked => {
                        root.import-files-requested();
                    }
                }

                MenuItem {
                    glyph: Glyph.folder;
                    text: "从文件夹导入…";
                    detail: "整个文件夹一次导入，默认建议按目录名新建分类";
                    clicked => {
                        root.import-requested();
                    }
                }
            }
        }

        // D51 范围菜单：锚在搜索框前缀 chip 下方；两段式动效（open 挂载 /
        // shown 翻转由壳层下一帧置位，出场先收 shown 播完再收 open）。
        if root.scope-menu-open: Rectangle {
            property <bool> shown: root.scope-menu-shown;

            opacity: shown ? 1.0 : 0.0;
            x: scope-anchor.absolute-position.x;
            y: scope-anchor.absolute-position.y + scope-anchor.height + 6px + (shown ? 0px : -6px);
            width: 168px;
            height: scope-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: root.animations-enabled ? 150ms : 0ms; easing: ease-out; }

            scope-layout := VerticalLayout {
                padding: 6px;
                spacing: 4px;

                MenuItem {
                    glyph: Glyph.search;
                    text: "全部";
                    detail: "名称 + 分类 + 标签";
                    clicked => { root.scope-selected(0); }
                }
                MenuItem {
                    glyph: Glyph.file;
                    text: "文件名";
                    detail: "只搜素材文件名";
                    clicked => { root.scope-selected(1); }
                }
                MenuItem {
                    glyph: Glyph.layers;
                    text: "分类";
                    detail: "只搜分类名";
                    clicked => { root.scope-selected(2); }
                }
                MenuItem {
                    glyph: Glyph.check;
                    text: "标签";
                    detail: "只搜标签名";
                    clicked => { root.scope-selected(3); }
                }
            }
        }

        // 设置面板：右对齐锚在设置按钮下方。高度上限 = 锚点下缘到窗底——
        // 矮窗口不再把面板底部截断或压到底部操作条后面，超出部分面板内滚动。
        if root.settings-open: Rectangle {
            property <bool> shown: root.settings-shown;
            property <length> panel-top: settings-anchor.absolute-position.y + settings-anchor.height + 6px;
            init => {
                root.overlay-mounted(2);
            }

            opacity: shown ? 1.0 : 0.0;
            x: Math.max(12px, settings-anchor.absolute-position.x + settings-anchor.width - self.width);
            y: panel-top + (shown ? 0px : -6px);
            width: 316px;
            height: Math.min(settings-scroll-col.preferred-height + 24px,
                root.height - panel-top - 12px);
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: root.animations-enabled ? 150ms : 0ms; easing: ease-out; }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                // 固定头（不随滚动）：「关闭」必须常驻——D67 起点外部不再
                // 收起本面板，显式出口只剩这个按钮和 Esc。
                HorizontalLayout {
                    spacing: 8px;
                    SectionLabel {
                        height: 14px;
                        text: "设置";
                        horizontal-stretch: 1;
                    }
                    FlatButton {
                        text: "关闭";
                        glyph: Glyph.close;
                        clicked => { root.settings-closed(); }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    viewport-height: settings-scroll-col.preferred-height;

                    settings-scroll-col := VerticalLayout {
                        spacing: 10px;

                        // 通用渲染：行数据全部来自壳层的 SettingRowData 模型（含
                        // 分区标题行），新增设置项只改 Rust 侧描述（SettingSpec）。
                        // 包裹层必须用 VerticalLayout：裸 Rectangle 不向布局上报
                        // 子内容的首选高度，整列 preferred 塌成 0、面板压缩叠行
                        // （渲染实测）；布局元素才传播子项 layout info。
                        for setting in root.settings: VerticalLayout {
                            if setting.header: SectionLabel {
                                height: 16px;
                                text: setting.title;
                            }
                            if !setting.header: SettingRow {
                                title: setting.title;
                                detail: setting.detail;
                                checked: setting.checked;
                                enabled: setting.enabled;
                                toggled => {
                                    root.setting-toggled(setting.key);
                                }
                            }
                        }

                        // D38：一键打开日志目录（全部子进程日志同目录，导出=拷贝该目录）。
                        // 归入「高级」组末尾（模型里最后一组是高级），样式走通用 FlatButton。
                        FlatButton {
                            text: "打开日志目录";
                            glyph: Glyph.folder-search;
                            tip: "全部进程的日志都在这里，导出问题反馈时拷贝整个目录";
                            clicked => { root.open-logs-requested(); }
                        }

                        // D61/D64 旧版库迁移：三态——可迁移（按钮）/ 已收账
                        // （留档可见 + 打开留档目录，回应「找不到原本数据源」）/
                        // 隐藏。文案与「关于」区同款克制风格，按钮态跟着 busy 走。
                        // if 必须包在 VerticalLayout **内部**（同上方设置行）：
                        // if 直接做布局子项时首选高度不传播，详情折行后
                        // 「关于」标题会贴上来（渲染实测）。
                        VerticalLayout {
                            spacing: 5px;

                            if root.migrate-legacy-available || root.migrate-legacy-done: SectionLabel {
                                height: 14px;
                                text: "数据迁移";
                            }

                            if root.migrate-legacy-available: FlatButton {
                                text: root.migrate-legacy-busy ? "迁移中…" : "一键迁移旧版素材";
                                enabled: !root.migrate-legacy-busy;
                                tip: "把旧版存放在安装目录旁的素材搬进统一素材库：自动去重、后台补缩略图，旧目录改名留档";
                                clicked => { root.migrate-legacy-requested(); }
                            }

                            if root.migrate-legacy-done: FlatButton {
                                text: "打开旧库留档目录";
                                glyph: Glyph.folder-search;
                                tip: "旧素材已并入统一素材库，原目录改名留档在这里；确认无误后可手动删除";
                                clicked => { root.open-migration-backup-requested(); }
                            }

                            if root.migrate-legacy-available || root.migrate-legacy-done: Text {
                                text: root.migrate-legacy-detail;
                                color: Theme.text-3;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }

                        // D56「关于」：版本读数 + 手动检查 + 状态行。文案跟着
                        // VM 状态走（检查中/已是最新/发现新版本/失败原因），
                        // 失败才着 danger 色——设置面板不搞情绪化大字。
                        VerticalLayout {
                            spacing: 5px;

                            SectionLabel {
                                height: 14px;
                                text: "关于";
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 1px;

                                    Text {
                                        text: "素材管理器 \{root.app-version}";
                                        color: Theme.text-2;
                                        font-size: 11px;
                                    }
                                }

                                FlatButton {
                                    text: root.update-checking ? "检查中…" : "检查更新";
                                    enabled: !root.update-checking;
                                    tip: "连到发布源核对有没有新版本（约几秒）";
                                    clicked => { root.update-check-requested(); }
                                }
                            }

                            Text {
                                text: root.update-status-text;
                                color: root.update-status-danger ? Theme.danger : Theme.text-3;
                                font-size: 10px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
        // —— D48 右键菜单浮层：锚右键命中点，坐标由壳层夹取（贴边不越窗）——
        if root.context-menu-open: Rectangle {
            x: Math.min(root.context-menu-x, root.width - 220px);
            y: Math.min(root.context-menu-y, root.height - 260px);
            width: 220px;
            height: menu-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            menu-layout := VerticalLayout {
                padding: 6px;
                spacing: 4px;

                if root.context-menu-title != "": Text {
                    text: root.context-menu-title;
                    color: Theme.text-3;
                    font-size: 10px;
                    x: 4px;
                    width: parent.width - 8px;
                    overflow: elide;
                }

                MenuItem {
                    glyph: Glyph.paste;
                    text: "复制";
                    detail: "素材进剪贴板，绝不代发";
                    clicked => {
                        root.menu-action(0);
                    }
                }
                MenuItem {
                    glyph: Glyph.folder;
                    text: "移动到分类";
                    clicked => {
                        root.menu-action(1);
                    }
                }
                MenuItem {
                    glyph: Glyph.file-text;
                    text: "重命名";
                    clicked => {
                        root.menu-action(2);
                    }
                }
                MenuItem {
                    glyph: Glyph.info;
                    text: "属性";
                    clicked => {
                        root.menu-action(3);
                    }
                }
                MenuItem {
                    glyph: Glyph.trash;
                    text: "删除";
                    detail: "进回收站，可恢复";
                    clicked => {
                        root.menu-action(4);
                    }
                }
            }
        }

        // —— 「移动到分类」弹层：现有分类逐条 + 输入新名新建（统一归入同款交互）——
        if root.move-menu-open: Rectangle {
            x: Math.max(0px, (root.width - 280px) / 2);
            y: 120px;
            width: 280px;
            height: move-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            move-layout := VerticalLayout {
                padding: 10px;
                spacing: 6px;

                Text {
                    text: "移动到分类";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }

                // 现有分类：横向滚动太挤，直接纵向列（分类数量级 <20）。
                // 高度必须显式钉值：内建 ScrollView 的 preferred 是 100%，在
                // 「弹层高度 = 布局 preferred」的弹层里循环依赖，会塌到内建
                // min-height(50px) 附近，列表只剩一条缝；钉 min(200px, 内容高)
                // 才能按内容展开、超过 200px 出滚动条。
                ScrollView {
                    height: Math.min(200px, move-cats.preferred-height);
                    viewport-width: self.visible-width;
                    viewport-height: move-cats.preferred-height;

                    move-cats := VerticalLayout {
                        spacing: 4px;
                        // 「全部」不是目的地，直接不实例化——visible:false 在
                        // Slint 布局里仍占一格（只藏不缩），会在视口顶端留空行。
                        // for 体不能直接接 if（parse error），包一层布局才上报
                        // preferred（裸包裹层会让整列 preferred 塌成 0）。
                        for name[i] in root.categories: VerticalLayout {
                            if i > 0: Rectangle {
                                height: 30px;
                                border-radius: Theme.radius;
                                border-width: 1px;
                                border-color: move-cat-touch.has-hover ? Theme.accent : Theme.line;
                                background: move-cat-touch.has-hover ? Theme.bg-raised-hover : Theme.bg-raised;

                                Text {
                                    x: 10px;
                                    text: name;
                                    color: Theme.text-2;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                move-cat-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.move-to-category(name);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.move-error != "": Text {
                    text: root.move-error;
                    color: Theme.danger;
                    font-size: 10px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 6px;
                    move-name := LineEdit {
                        placeholder-text: "输入新分类名即新建";
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "新建并移入";
                        primary: true;
                        clicked => {
                            root.move-to-category(move-name.text);
                        }
                    }
                }
            }
        }

        // —— D47/D46 底部操作条：多选与回收站两种形态 ——
        // 宽度自适应：窄窗口夹到窗宽-32px，按钮不再被挤出条外（D48 教训的补全）。
        if root.selection-bar != UiEnums.bar-hidden: Rectangle {
            y: root.height - self.height - 16px;
            x: (root.width - self.width) / 2;
            width: Math.min(560px, root.width - 32px);
            height: 48px;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;

                Text {
                    text: root.selection-text;
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    // 兜底：内容超宽时省略而非把按钮挤出条外（D48 实测教训）。
                    overflow: elide;
                    max-width: 240px;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // 高度统一钉 30px（与顶栏/侧栏控件同一档）；批量动作 0 选禁用——
                // 「已选 0 项」时可点删除只会得到一次空操作报错，禁用即说明。
                if root.selection-bar == UiEnums.bar-multi: Button {
                    height: 30px;
                    text: "全选";
                    clicked => { root.select-all-requested(); }
                }
                if root.selection-bar == UiEnums.bar-multi: Button {
                    height: 30px;
                    enabled: root.selection-count > 0;
                    text: "移动到分类";
                    clicked => { root.move-selection-requested(); }
                }
                if root.selection-bar == UiEnums.bar-multi: DangerButton {
                    height: 30px;
                    enabled: root.selection-count > 0;
                    text: "删除";
                    clicked => { root.delete-selection-requested(); }
                }
                if root.selection-bar == UiEnums.bar-multi: Button {
                    height: 30px;
                    text: "取消";
                    clicked => { root.select-mode-toggled(); }
                }

                if root.selection-bar == UiEnums.bar-trash: Button {
                    height: 30px;
                    text: "全选";
                    clicked => { root.select-all-requested(); }
                }
                if root.selection-bar == UiEnums.bar-trash: Button {
                    height: 30px;
                    enabled: root.selection-count > 0;
                    text: "恢复";
                    clicked => { root.restore-selection-requested(); }
                }
                if root.selection-bar == UiEnums.bar-trash: DangerButton {
                    height: 30px;
                    enabled: root.selection-count > 0;
                    text: "彻底删除";
                    clicked => { root.purge-selection-requested(); }
                }
                if root.selection-bar == UiEnums.bar-trash: DangerButton {
                    height: 30px;
                    text: root.empty-trash-text;
                    armed: root.empty-trash-armed;
                    clicked => { root.empty-trash-requested(); }
                }
            }
        }

        // —— 重命名弹窗 ——
        if root.rename-open: Rectangle {
            x: (root.width - 340px) / 2;
            y: 150px;
            width: 340px;
            height: rename-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            rename-layout := VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: "重命名";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }

                rename-input := LineEdit {
                    text: root.rename-current;
                    placeholder-text: "新名称（只改显示名，不动磁盘路径）";
                }

                if root.rename-error != "": Text {
                    text: root.rename-error;
                    color: Theme.danger;
                    font-size: 10px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "取消";
                        clicked => {
                            root.rename-canceled();
                        }
                    }
                    Button {
                        text: "保存";
                        primary: true;
                        clicked => {
                            root.rename-confirmed(rename-input.text);
                        }
                    }
                }
            }
        }

        // —— 属性弹窗（R13：尺寸/大小/导入时间/绝对路径）——
        if root.properties-open: Rectangle {
            x: (root.width - 420px) / 2;
            y: 120px;
            width: 420px;
            height: props-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            props-layout := VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.props-name;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                // 两列网格：左标签右值。空值（如视频无宽高）显示 —。
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "尺寸"; width: 70px; color: Theme.text-3; font-size: 11px; }
                        Text { text: root.props-size; horizontal-stretch: 1; color: Theme.text; font-size: 11px; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "大小"; width: 70px; color: Theme.text-3; font-size: 11px; }
                        Text { text: root.props-bytes; horizontal-stretch: 1; color: Theme.text; font-size: 11px; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "导入时间"; width: 70px; color: Theme.text-3; font-size: 11px; }
                        Text { text: root.props-created; horizontal-stretch: 1; color: Theme.text; font-size: 11px; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "路径"; width: 70px; color: Theme.text-3; font-size: 11px; }
                        Text { text: root.props-path; horizontal-stretch: 1; color: Theme.text; font-size: 11px; wrap: word-wrap; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "打开所在文件夹"; clicked => { root.properties-folder-requested(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "关闭"; clicked => { root.properties-closed(); } }
                }
            }
        }

        // —— D56 新版本弹窗：命中动作是「打开发布页」，应用内下载安装明确
        // 推迟（签名校验/安装器自更新是独立大项目，D56）。两段式入场（同
        // classify）；Esc /「以后再说」= 以后再说，跳过此版本单独走回调
        // （D67 起点外部只挡不关）。
        if root.update-open: Rectangle {
            property <bool> shown: root.update-shown;

            opacity: shown ? 1.0 : 0.0;
            x: (root.width - 400px) / 2;
            y: 130px + (shown ? 0px : 8px);
            width: 400px;
            height: update-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: root.animations-enabled ? 150ms : 0ms; easing: ease-out; }

            update-layout := VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Glyph.export;
                        tint: Theme.accent;
                        width: 16px;
                        height: 16px;
                    }

                    Text {
                        text: "发现新版本 \{root.update-version}";
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                Text {
                    text: "当前版本 \{root.app-version} · 下载安装请前往发布页";
                    color: Theme.text-3;
                    font-size: 10px;
                }

                // notes 滚动区：高度钉 min(200px, 内容高)——不钉会塌成 ScrollView
                // 内建 min-height（「移动到分类」弹层同款坑，D48）；Text 包在
                // VerticalLayout 里让换行宽度跟随视口（裸 Text 在 ScrollView 里按
                // preferred 展开成单行）。
                if root.update-notes != "": ScrollView {
                    height: Math.min(200px, update-notes-col.preferred-height);
                    viewport-width: self.visible-width;
                    viewport-height: update-notes-col.preferred-height;

                    update-notes-col := VerticalLayout {
                        Text {
                            text: root.update-notes;
                            color: Theme.text-2;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    FlatButton {
                        text: "跳过此版本";
                        tip: "以后启动不再提醒这个版本；手动检查仍会显示";
                        clicked => { root.update-skip-version(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "以后再说";
                        clicked => { root.update-later(); }
                    }

                    Button {
                        text: "打开发布页";
                        primary: true;
                        enabled: root.update-url != "";
                        clicked => { root.update-open-release-page(); }
                    }
                }
            }
        }

        // D66 导入归类弹窗：居中卡片，行 = 来源组，三操作（归入/新建/待分类）。
        // 归入展开 = 检索框 + 候选列表（ScrollView 高度钉 min(166px, 内容高)
        // 整行裁齐防塌陷 + 防切行，update 弹窗同款坑）；新建展开 = 预填名输入。
        // 可解析包已由壳层静默直通（D66），不再有「按包内分类」操作项。入场
        // 下一帧翻转（shown 由壳层在 open 后置位），出场两段式（shown 先收、
        // open 延迟一拍收）。
        if root.classify-open: Rectangle {
            property <bool> shown: root.classify-shown;

            opacity: shown ? 1.0 : 0.0;
            y: 96px + (shown ? 0px : 8px);
            x: (root.width - self.width) / 2;
            width: 480px;
            height: classify-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: root.animations-enabled ? 150ms : 0ms; easing: ease-out; }

            classify-layout := VerticalLayout {
                padding: 14px;
                spacing: 10px;

                SectionLabel {
                    height: 14px;
                    text: "导入归类";
                }

                Text {
                    text: "输入分类名实时检索；点「导入」归入已有或新建同名分类，也可放入待分类。";
                    color: Theme.text-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                // 只读清单：本次导入的来源构成（批次级 = 决策只做一次，来源
                // 不再逐组成卡）。
                Text {
                    text: "本次导入：" + root.classify-summary;
                    color: Theme.text-3;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                LineEdit {
                    height: 30px;
                    text: root.classify-argument;
                    placeholder-text: "输入分类名，实时匹配已有分类…";
                    edited(text) => { root.classify-name-changed(text); }
                    accepted(text) => { root.classify-name-changed(text); }
                }

                // 候选列表：ScrollView 高度钉 min(166px, 内容高)，不钉会塌成
                // 内建 min-height（update 弹窗同款坑）。166px = 6 行整行裁齐
                // （行 26px + 间距 2px → 5 行 138px / 6 行 166px）——钉 150px
                // 会把第 6 行拦腰截断，文字切一半像渲染坏了；候选封顶 8 条
                // （MATCH_CAP），超出的靠列表内滚动，弹窗高度恒定。
                if root.classify-matches.length > 0: ScrollView {
                    height: Math.min(166px, matches-col.preferred-height);
                    viewport-width: self.visible-width;
                    viewport-height: matches-col.preferred-height;

                    matches-col := VerticalLayout {
                        spacing: 2px;

                        for name in root.classify-matches: Rectangle {
                            height: 26px;
                            border-radius: Theme.radius;
                            background: name == root.classify-argument ? Theme.accent-soft
                                : (row-hover.has-hover ? Theme.bg-raised-hover : transparent);
                            row-hover := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.classify-picked(name); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: name;
                                    color: name == root.classify-argument ? Theme.accent : Theme.text-2;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // 实时预告行：导入前把结果说清楚（自动建分类不留无感知）。
                Text {
                    text: root.classify-hint;
                    color: root.classify-hint-kind == UiEnums.classify-hint-existing ? Theme.accent
                        : root.classify-hint-kind == UiEnums.classify-hint-new ? Theme.warn
                        : Theme.text-3;
                    font-size: 10px;
                    wrap: word-wrap;
                }


                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "取消"; clicked => { root.classify-canceled(); } }
                    Button { text: "放入待分类"; clicked => { root.classify-confirmed(UiEnums.classify-confirm-inbox); } }
                    Button { text: "导入"; primary: true; clicked => { root.classify-confirmed(UiEnums.classify-confirm-resolve); } }
                }
            }
        }

        // D65 导入结果弹窗：跳过/相似/失败的持久逐项点名。顶部锚定 y120（弹窗
        // 族约定 96–150px，不做垂直居中）；行数超窗走 ScrollView（高度钉
        // min(320px, 内容高)，不钉会塌成内建 min-height——update 弹窗同款坑）。
        if root.import-result-open: Rectangle {
            property <bool> shown: root.import-result-shown;

            opacity: shown ? 1.0 : 0.0;
            x: (root.width - self.width) / 2;
            y: 120px + (shown ? 0px : 8px);
            width: 560px;
            height: result-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: root.animations-enabled ? 150ms : 0ms; easing: ease-out; }

            result-layout := VerticalLayout {
                padding: 14px;
                spacing: 10px;

                SectionLabel {
                    height: 14px;
                    text: "导入结果";
                }

                Text {
                    text: root.import-result-summary;
                    color: Theme.text-2;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                ScrollView {
                    height: Math.min(320px, result-rows.preferred-height);
                    viewport-width: self.visible-width;
                    viewport-height: result-rows.preferred-height;

                    result-rows := VerticalLayout {
                        spacing: 4px;

                        for row in root.import-result-rows: Rectangle {
                            height: 40px;
                            border-radius: Theme.radius;
                            background: Theme.bg-panel;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;

                                Rectangle {
                                    height: 18px;
                                    width: result-badge.preferred-width + 16px;
                                    border-radius: 999px;
                                    background: row.kind == UiEnums.result-row-failed ? Theme.danger-soft
                                        : row.kind == UiEnums.result-row-similar ? Theme.accent-soft
                                        : Theme.warn-soft;

                                    result-badge := Text {
                                        text: row.kind == UiEnums.result-row-failed ? "失败"
                                            : row.kind == UiEnums.result-row-similar ? "相似 " + row.distance
                                            : "完全相同";
                                        color: row.kind == UiEnums.result-row-failed ? Theme.danger
                                            : row.kind == UiEnums.result-row-similar ? Theme.accent
                                            : Theme.warn;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                Text {
                                    text: row.source;
                                    color: Theme.text;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 2;
                                }

                                Text {
                                    // failed 行右列 = 失败原因；exact 是字节等值（非相似，
                                    // 不带 ≈）；similar 才是相似提示。
                                    text: row.kind == UiEnums.result-row-failed ? row.existing
                                        : row.kind == UiEnums.result-row-exact ? "已有素材 " + row.existing
                                        : "≈ 已有素材 " + row.existing;
                                    color: Theme.text-3;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 3;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "知道了";
                        primary: true;
                        clicked => { root.import-result-closed(); }
                    }
                }
            }
        }
    }
    } // key-root FocusScope 收口
}
