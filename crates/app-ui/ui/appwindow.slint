import { ToastHost, InlineNotice, NoticeHistory, NoticeRow, NoticeTone } from "notifications.slint";
export { NoticeRow } from "notifications.slint";
// 素材管理器主窗：哑渲染——只绑定属性与转发回调，业务逻辑全在 ui-viewmodels。
//
// 配色/圆角/图标一律走 theme.slint 的令牌与字形表；输入框、按钮、进度条用内置
// std-widgets：样式钉在 fluent（常量表层明暗双份），运行时经 Palette.color-scheme
// 与自绘层同步翻转（D37），两层观感一体。
import { Button, CheckBox, LineEdit, ProgressIndicator, ScrollView, Palette, ComboBox } from "std-widgets.slint";
import { Theme, Typography, Spacing, Metrics, Motion, TitleLabel, Icon, Glyph, IconButton, DangerButton, FlatButton, SectionLabel, SettingRow, MenuItem, DialogInput } from "theme.slint";
// 把导入的全局再导出一次：Rust 侧经 `ui.global::<Theme>()` 注入运行时主题令牌。
export { Theme } from "theme.slint";
// 显式再导出内置 Palette 全局：std-widgets（fluent 样式）的全部内部颜色都是从
// `Palette.color-scheme` 实时推导的活绑定，Rust 侧拿到句柄后写 color-scheme
// 即可在运行时整体翻转明暗——这是「浅色主题切不全」问题的正解（D37）。
export { Palette }

// UI 共享枚举常量：消灭 .slint 里的魔法数字（综合分析报告「三.9」）。
// 数字值与 app-ui/src/ui_enums.rs 的映射保持一致。
export global UiEnums {
    out property <int> target-mode-empty: 0;
    out property <int> target-mode-ready: 1;
    out property <int> target-mode-needs-confirmation: 2;
    out property <int> target-mode-choose: 3;
    out property <int> notice-tone-success: NoticeTone.success;
    out property <int> notice-tone-warning: NoticeTone.warning;
    out property <int> notice-tone-error: NoticeTone.error;
    // 目标健康度：颜色由视图映射到 Theme.ok/warn/danger/text-3。
    out property <int> target-health-green: 0;
    out property <int> target-health-yellow: 1;
    out property <int> target-health-red: 2;
    out property <int> target-health-unknown: 3;
    out property <int> card-kind-image: 0;
    out property <int> card-kind-video: 1;
    out property <int> card-kind-text: 2;
    out property <int> card-kind-other: 3;
    // D48 底部操作条形态：隐藏 / 多选（Normal）/ 回收站视图。
    out property <int> bar-hidden: 0;
    out property <int> bar-multi: 1;
    out property <int> bar-trash: 2;
    // D65 导入结果行形态。
    out property <int> result-row-exact: 0;
    out property <int> result-row-similar: 1;
    out property <int> result-row-failed: 2;
    // D66 归类弹窗：预告行形态（待分类/已有/新建）与「导入」按钮语义
    // （按输入解析 / 直入待分类）。
    out property <int> classify-hint-inbox: 0;
    out property <int> classify-hint-existing: 1;
    out property <int> classify-hint-new: 2;
    out property <int> classify-confirm-resolve: 0;
    out property <int> classify-confirm-inbox: 1;
    // D80 共享角标三态（与 ui_viewmodels::ShareBadge 对齐）：无/在途/已送达/失败。
    out property <int> share-badge-none: 0;
    out property <int> share-badge-busy: 1;
    out property <int> share-badge-done: 2;
    out property <int> share-badge-failed: 3;
}

// D88 检索态正文片段的分段：hit 段垫 accent-soft 高亮底，普通段透明。
export struct TextSegment {
    text: string,
    hit: bool,
}

export struct TileData {
    x: length,
    y: length,
    w: length,
    h: length,
    asset-id: int,
    label: string,
    color: color,
    // 浏览用缩略图（离线派生的 <=320px PNG）。缺图时为空 image，露出 color 兜底。
    thumb: image,
    // D53 淡入标志：true = 有图（缓存命中/新装出），false = 缺图占位。
    // false→true 翻转（fill 补齐）播 150ms 淡入；挂载即 true 不重播（滚动/切页）。
    thumb-fade: bool,
    // 素材类别（UiEnums.card-kind-*，与 domain::AssetKind 对齐）：卡片按类别切表现。
    kind: int,
    // 文本类素材的头部预览（首行若干字符，默认态）；其余类别为空串。
    preview: string,
    // D88 检索态正文片段（带命中标记的分段）；空模型 = 默认头部预览。
    search-segments: [TextSegment],
    // D47 选中标记：勾选角标 + accent 描边由它驱动。
    selected: bool,
    // D80 共享角标（UiEnums.share-badge-*）：右上类型徽标下方一枚状态点。
    share-badge: int,
    // D80-M1「共享中」角标：素材在任一共享域中（可获得性广播，不涉及传输）。
    shared: bool,
    // D91 一致性状态：正本被外部删除（missing，红点）或被外部修改待重索引
    // （stale，黄点）。宿主从 reindex 子进程的 MARK/FIXED 行现查线程局部集
    // 合（与 shared 同一现查纪律），重索引完成后消失。
    missing: bool,
    stale: bool,
}

export struct SettingRowData {
    key: string,
    title: string,
    detail: string,
    checked: bool,
    enabled: bool,
    // true = 分区标题行（title 承载组名，如「上框行为」），不渲染开关。
    // 由壳层按 SETTING_SPECS 的 section 字段插入，视图侧不做分组推断。
    header: bool,
}

export struct TargetChoiceData {
    selection-key: string,
    label: string,
    // 别名覆盖前的默认标签（profile · 窗口标题），重命名弹层的标题行回显用。
    default-label: string,
    status: string,
    // UiEnums.target-health-*：颜色在视图侧取 Theme 令牌。
    health: int,
    available: bool,
}

// D76.4 上框点位（高级）行数据：声明了 input_point 的目标 + 当前生效表达式
// （画像链合并结果；保存进 settings.toml 覆盖层，优先级 > profiles.user.toml）。
export struct TargetTuningData {
    target-id: string,
    label: string,
    point-x: string,
    point-y: string,
}

// D65 导入结果行：kind = UiEnums.result-row-*（0=完全相同跳过 1=相似已导入
// 2=失败）；source = 导入源文件名；existing = 已有素材名（exact/similar）或
// 失败原因（failed）；distance = 感知距离（仅 similar 行有意义）。
export struct ImportResultRowData {
    kind: int,
    source: string,
    existing: string,
    distance: int,
}

// D80 设备选择弹窗行：name = mDNS 主机名；detail = 首个可达地址；selected = 单选高亮。
export struct ShareDeviceData {
    name: string,
    detail: string,
    selected: bool,
}

// D80-M1 控制面行：设备册（id 供移除/改名回调回传）/ 域册（shared = 当前素材对
// 该域共享中；selected = 管理弹窗选中高亮）/ 域成员勾选行。
// D80-M2 收敛：detail（配对码指纹）移除——邀请直发模型里核对动作消失，
// 全流程只认「我的邀请码 + 贴对方邀请码」一个凭据。
export struct ShareCtlDeviceData {
    id: string,
    name: string,
}

export struct ShareCtlDomainData {
    id: string,
    name: string,
    member-count: int,
    shared: bool,
    // M1-c：个人域（单成员）与群组域在行上区分展示。
    is-personal: bool,
    selected: bool,
}

export struct ShareCtlMemberData {
    id: string,
    name: string,
    checked: bool,
}

// D90 共享空间行（侧栏空间段 + 空间管理弹窗 + 添加到空间弹窗共用）：
// id = 空间 uuid 文本（回调回传寻址）；sub-label = 成员数（P2 追加同步态）。
export struct SpaceRowData {
    id: string,
    name: string,
    sub-label: string,
}

// D80-M1-b 发现面行：对端（id 供选中回传 / detail = 可得项数）与它的可得清单行
//（asset-id 供索取回调回传；kind = UiEnums.card-kind-*；size = 人话字节数）。
export struct ShareFacePeerData {
    name: string,
    detail: string,
    offer-count: int,
    selected: bool,
}

export struct ShareFaceOfferData {
    asset-id: string,
    name: string,
    kind: int,
    size: string,
}

export component AppWindow inherits Window {
    title: "素材管理器";
    // 窗口图标（标题栏/任务栏/Alt-Tab）：路径相对本文件指向仓库根 assets/。
    // Explorer/快捷方式用的 exe 资源图标不在这里，由 build.rs 经 winresource 另嵌。
    icon: @image-url("../../../assets/window-icon.png");
    preferred-width: 1000px;
    preferred-height: 700px;
    background: Theme.bg-app;

    // —— VM 绑定面（由壳层写入/读取）——
    in-out property <length> content-height: 1px;
    in-out property <length> content-y: 0px; // 与 Flickable viewport-y 双向绑定，壳层只读
    out property <length> viewport-height: flick.height;
    out property <length> viewport-width: flick.width;
    in property <[TileData]> tiles;
    in property <string> total-text: "";
    in property <string> filter-label: "全部";
    in property <[string]> categories: ["全部"];
    in property <[int]> category-counts: [];
    // -1 = 全部，-2 = 检索结果态（不高亮任何分类），>=0 = 具体分类号
    in property <int> selected-category: -1;
    in-out property <string> search-text: "";
    // 当前正在使用的素材（最近一次上框），用于在网格里标出焦点。
    in property <int> active-asset-id: -1;
    // 空态文案：由壳层按「库空 / 检索无结果 / 分类为空」分别填。
    in property <string> empty-title: "";
    in property <string> empty-hint: "";
    in property <string> target-label: "点击选择聊天窗口";
    in property <int> target-health: 3;
    in property <bool> target-pinned: false;
    in property <int> target-mode: 0;
    in property <[TargetChoiceData]> target-choices;
    // 目标实例重命名弹层（右键 picker 行触发）：别名写进 targets.json，
    // chip 与 picker 同步显示；留空保存 = 恢复默认名。
    in property <bool> target-rename-open: false;
    in property <string> target-rename-default: "";
    in-out property <string> target-rename-text: "";
    callback target-rename-requested(string);
    callback target-rename-confirmed(string);
    callback target-rename-cancelled();
    in property <string> notice-text: "";
    in property <int> notice-tone: 0;
    callback notice-dismissed();
    in-out property <bool> notice-hovered: false;
    in-out property <bool> notice-history-open: false;
    in property <[NoticeRow]> notice-history;
    in property <string> notice-banner;
    in property <bool> import-result-available: false;
    callback import-result-requested();
    in property <bool> progress-visible: false;
    in property <float> progress-percent: 0.0;
    in property <string> progress-text: "";
    in property <string> clear-button-text: "清空素材库";
    in property <bool> clear-button-armed: false;
    // 设置：描述化模型（key/title/detail/checked）+ 面板开合。
    in property <[SettingRowData]> settings: [];
    in property <bool> single-click-activate: false;
    in property <bool> send-after-paste: false;
    in property <bool> settings-open: false;
    in property <bool> gpu-rendering: false;
    // 界面动画开关（设置面板「界面动画」）：同步到 Motion.enabled，悬停/按压/
    // 开关/浮层/瓦片淡入的全部过渡时长由此钳到 0。
    in property <bool> animations-enabled: true;
    // 导入菜单（左下角单入口弹层）开合：与 settings-open 同模式，壳层管理。
    in property <bool> import-menu-open: false;
    // 左侧分类侧栏宽度：拖动分隔条实时改，松手经 sidebar-resize-ended 持久化。
    in-out property <length> sidebar-width: 212px;
    // 拖动夹取范围（壳层持久化时用同一组数字，改这里需同步 main.rs 常量）。
    property <length> min-sidebar-width: 150px;
    property <length> max-sidebar-width: 420px;
    // 唤出全量重绘哨兵翻转位：platform::win32::paint_guard 在「系统整窗失效」
    // （最小化恢复/遮挡重现，DWM 已丢窗口表面）时翻转此属性 → repaint-sentinel
    // 的 opacity 绑定变化 → 整窗标脏，逼部分重绘管线画一整帧盖掉黑区。
    in property <bool> repaint-nudge: false;

    // —— D47/D48 选区、菜单与弹窗状态（全部壳层驱动，视图无业务）——
    in property <int> selection-bar: 0; // UiEnums.bar-*
    in property <int> selection-count: 0; // 操作条按钮的可用性：0 选禁用批量动作
    in property <string> selection-text: ""; // 「已选 N 项」/ 0 选时的操作指引
    in property <bool> select-mode-active: false; // 顶栏按钮高亮
    in property <int> trash-count: 0; // 侧栏回收站角标（0 隐藏数字）
    in property <bool> rename-open: false;
    in property <string> rename-current: "";
    in property <string> rename-error: "";
    in property <bool> properties-open: false;
    in property <string> props-name: "";
    in property <string> props-size: "";
    in property <string> props-bytes: "";
    in property <string> props-created: "";
    in property <string> props-path: "";
    // 清空回收站的二段确认（与「清空素材库」DangerButton 同模式）。
    in property <bool> empty-trash-armed: false;
    in property <string> empty-trash-text: "清空回收站";
    // 「移动到分类」弹层：现有分类 + 「待分类」兜底项 + 新名输入框。
    in property <bool> move-menu-open: false;
    in property <string> move-error: "";

    // —— D66 导入归类弹窗（批次级：整批一个决策） ——
    // open 挂载 / shown 是入场动效翻转位：壳层在 open 置位后的下一帧再置
    // shown（D53 结论：init 技巧无效，首帧前翻转不会触发过渡）；出场两段式
    // 由壳层先收 shown 播完 150ms 再收 open。
    in property <bool> classify-open: false;
    in property <bool> classify-shown: false;
    // 只读来源清单行 + 单输入框状态（候选由壳层过滤封顶）。
    in property <string> classify-summary;
    in property <string> classify-argument;
    in property <[string]> classify-matches;
    // 实时预告行：输入框当前内容将导向哪类结果（UiEnums.classify-hint-*）。
    in property <string> classify-hint;
    in property <int> classify-hint-kind: 0;
    // probe 结果转接（子进程线程只许 Weak<AppWindow>，计数经回调回 UI 线程；
    // count -1 = none；finished 不带数据只做归零计数）。
    callback classify-probe-result(string, int);
    callback classify-probe-finished();
    // 输入同步（壳层重滤候选并刷新预告行）。
    callback classify-name-changed(string);
    // 候选点选 = 用列表规范名回填输入框。
    callback classify-picked(string);
    callback classify-canceled();
    // kind = UiEnums.classify-confirm-*：0 按输入解析（归入/新建）1 直入待分类。
    callback classify-confirmed(int);

    // —— D65 导入结果弹窗 ——
    // 去重/相似/失败的持久点名面板：瞬时通知条会自动消隐，而「素材去哪了」
    // 的结论必须可停留、可逐项核对（去重感知红线）。open/shown 两段式同
    // classify；明细行由壳层从子进程 RESULTITEM 协议行收集。
    in property <bool> import-result-open: false;
    in property <bool> import-result-shown: false;
    in property <string> import-result-summary: "";
    in property <[ImportResultRowData]> import-result-rows;
    callback import-result-closed();

    // —— D80 P2P 素材共享（M0：局域网 mDNS 发现 + 显式推送 + 双确认）——
    // 设备选择弹窗：列表 + 单选 + 扫描态。open 由壳层管理，关闭走显式
    // 按钮与 Esc（不吃 overlay-dismissed——D67 分级：弹窗不因误触背景丢输入）。
    in property <bool> share-devices-open: false;
    in property <[ShareDeviceData]> share-devices;
    in property <int> share-selected-device: -1;
    in property <bool> share-scan-busy: false;
    callback share-devices-closed();
    callback share-scan-requested();
    callback share-device-picked(int);
    callback share-confirm-requested();
    // 首连确认弹窗（接收侧第一道门）：正文由壳层从 VM 报价生成。
    in property <bool> share-offer-open: false;
    in property <string> share-offer-text: "";
    callback share-offer-accept();
    callback share-offer-reject();
    // 多选操作条「共享」入口（D90：主库视图 = 添加到共享空间；右键菜单走
    // menu-action(7)）。M0 直发经设置 direct-send-enabled 打开后语义不变。
    callback share-selection-requested();
    // 在途批次摘要条（多批并发「；」连接；空串 = 不渲染）。
        in property <string> share-summary-text: "";

    // —— D90 共享空间 ——
    // 作用域：进入空间 = 分类列表换成空间自己的（回收站/维护区只在主库
    // 视图渲染），顶栏后缀显示空间名。selected-space = 空间行下标。
    in property <bool> in-space-view: false;
    in property <int> selected-space: -1;
    in property <[SpaceRowData]> space-rows;
    // D90 拍板④：M0 直发默认隐藏，熟手经设置打开（菜单项据此渲染）。
    in property <bool> direct-send-enabled: false;
    callback space-picked(string);
    callback space-exit-requested();
    callback space-manage-open-requested();
    // 空间管理弹窗（D90 后唯一的共享管理面）：创建 + 清单 + 邀请码。
    in property <bool> space-ctl-open: false;
    in property <bool> space-ctl-ready: false;
    in-out property <string> space-new-name: "";
    in property <string> space-ctl-error: "";
    // 邀请码展示（space-ctl-invite-for 指明所属空间；空串 = 收起展示）。
    in property <string> space-ctl-invite: "";
    in property <string> space-ctl-invite-for: "";
    callback space-create(string);
    callback space-leave(string);
    callback space-invite-copy(string);
    callback space-invite-reset(string);
    // 贴码加入（D90-P2）：粘贴同事给的邀请码，一次点击加入。
    in-out property <string> space-join-code: "";
    callback space-join(string);
    callback space-ctl-closed();
    // 「添加到共享空间」弹窗：行即空间，点击即加（右键菜单 menu-action(7)）。
    in property <bool> space-add-open: false;
    in property <[SpaceRowData]> space-add-rows;
    in property <string> space-add-hint: "";
    callback space-add-picked(string);
    callback space-add-closed();

    // —— 回调转发（无业务逻辑）——
    callback scroll-changed(length);
    callback viewport-resized();
    callback double-clicked(int);
    callback tile-clicked(int);
    // D83 素材点击免激活：素材格 hover 态喂给平台层（WM_MOUSEACTIVATE 裁决）。
    callback tile-hover-changed(bool);
    // D47 选区交互：瓦片 pointer-event 拆件（up 左键带修饰 = tile-modified-click；
    // up 右键 = tile-right-click 带瓦片绝对坐标供菜单定位）。坐标是窗口逻辑像素。
    callback tile-modified-click(int, bool, bool);
    // 顶栏「选择」按钮 / 操作条「取消」/ Esc 共用的模式开关（壳层判方向）。
    callback select-mode-toggled();
    // 操作条动作：全选 / 移动到分类 / 删除 / 恢复 / 彻底删除 / 清空回收站。
    callback select-all-requested();
    callback move-selection-requested();
    callback delete-selection-requested();
    // 库写子命令（trash/restore/purge/empty-trash/rename/move-category）收尾信号：
    // 子进程线程只能持 Weak，收尾一律经本回调弹回 UI 线程处理（同 export-finished 模式）。
    callback libcmd-finished(bool, string, string);
    callback restore-selection-requested();
    callback purge-selection-requested();
    callback empty-trash-requested();
    // 菜单动作回传（id 编码 0=复制..4=删除，与 selection::MenuAction 对齐）；
    // 移动到分类的两级目的地（现有分类名或新名，壳层校验）。
    callback tile-right-click(int, length, length);
    in property <bool> context-menu-open: false;
    in property <length> context-menu-x: 0px;
    in property <length> context-menu-y: 0px;
    in property <string> context-menu-title: ""; // 目标摘要（「3 项」或文件名）
    callback menu-action(int);
    callback move-to-category(string);
    callback context-menu-dismissed();
    // 重命名弹窗确认（新名；壳层 trim 校验非空/无路径分隔）与取消。
    callback rename-confirmed(string);
    callback rename-canceled();
    // D84 分类右键：up 右键带命中分类名与绝对坐标（同瓦片右键模式）；
    // 菜单动作回传 0=重命名 1=删除（删除=素材回待分类，不动文件）。
    callback cat-right-click(string, length, length);
    in property <bool> cat-menu-open: false;
    in property <length> cat-menu-x: 0px;
    in property <length> cat-menu-y: 0px;
    in property <string> cat-menu-title: ""; // 命中分类名
    callback cat-menu-action(int);
    // 分类重命名弹窗（新名；壳层校验非空/无路径分隔/不与现有分类重名）。
    in property <bool> cat-rename-open: false;
    in property <string> cat-rename-current: "";
    in property <string> cat-rename-error: "";
    callback cat-rename-confirmed(string);
    callback cat-rename-canceled();
    callback properties-folder-requested();
    callback properties-closed();
    // Ctrl+A / Esc 键盘通道：Esc 走 capture（永远赢），Ctrl+A 走 bubble 兜底
    //（见 key-root 注释），业务判定在壳层。
    callback key-a-pressed();
    callback escape-pressed();
    // D79 粘贴导入：Ctrl+V bubble 兜底（弹层关闭且无人认领时）→ 壳层读剪贴板
    // CF_HDROP 走与拖入同一导入流。提权会话收不到 Explorer 拖入（UIPI），这是
    // 等价入口。
    callback paste-import-requested();
    // 启动时给 key-root 上焦：Slint 不为子元素生成 get_* 访问器，聚焦只能
    // 在 .slint 内自理（Rust 侧 invoke，处理器里调元素方法）。
    callback key-focus-requested();
    key-focus-requested => { key-root.focus(); }
    callback filter-selected(int); // -1 = 全部，-2 = 检索结果态，-3 = 回收站，其余为分类号
    callback search-changed(string);
    callback target-chip-clicked();
    callback target-choice-selected(string);
    callback target-pin-toggled();
    // D76.5 上框点位（设置面板高级区点开独立弹窗）：选目标回填表达式并弹窗；
    // 保存先校验再写 settings.toml 覆盖层并热生效，成功/取消都收弹窗；
    // 恢复默认 = 删除该目标覆盖（弹窗留在原地便于继续看回填值）。
    in property <[TargetTuningData]> target-tunings;
    in property <bool> tuning-open: false;
    in property <string> tuning-selected-id: "";
    in property <string> tuning-selected-label: "";
    in-out property <string> tuning-x-text: "";
    in-out property <string> tuning-y-text: "";
    in property <string> tuning-error: "";
    callback tuning-selected(string);
    callback tuning-save(string, string);
    callback tuning-reset();
    callback tuning-cancelled();
    callback settings-toggled();
    // D67 设置面板显式关闭（点外部不再收起——见挡板注释）。
    callback settings-closed();
    callback setting-toggled(string);
    callback overlay-dismissed();
    callback import-requested();
    // D49 主导入：文件对话框多选（素材 + .emo 混选）。
    callback import-files-requested();

    // —— D51 搜索范围下拉 ——
    // scope: 0=全部 1=文件名 2=分类 3=标签（UiEnums 收口，D32 纪律）。
    in property <int> search-scope: 0;
    in property <bool> scope-menu-open: false;
    in property <bool> scope-menu-shown: false; // 两段式动效翻转位（同 classify）

    // —— D53 旧三弹层入场修复（init 技巧无效 → init 只报数，Rust 下帧翻转）。
    // 出场维持现状（即时卸载）：目标下拉的关闭由轮询驱动的 sync_target_bar
    // 拍板，两段式卸载会与轮询状态机竞态——差异走查记 design §1。
    in property <bool> target-picker-shown: false;
    in property <bool> import-menu-shown: false;
    in property <bool> settings-shown: false;
    // which: 0=目标下拉 1=导入菜单 2=设置面板。
    callback overlay-mounted(int);
    callback scope-menu-toggled();
    callback scope-selected(int);
    // OS 拖入文件（IDropTarget 兜底，platform::win32::dragdrop 注册）：
    // 路径列表进同一归类弹窗；不支持类型由 VM 过滤（R4）。
    callback files-dropped([string]);
    callback import-menu-toggled();
    // 手动刷新（导入菜单第三项）：重载库 + 重跑缩略图派生（只补缺失）。
    callback refresh-library-requested();
    callback sidebar-resize-ended(length);
    callback clear-library-requested();
    callback export-emo-requested();
    callback export-progress(int, int);
    callback export-finished(bool, string);
    callback poll-targets();
    callback thumbnails-generated();
    callback thumbnail-progress(int, int);
    callback import-progress(int, int);
    callback import-finished(bool, string);
    // D38：设置面板底部「打开日志目录」。
    callback open-logs-requested();
    // D82 日志导出：两段确认装填态（第一击置 true，第二击导出并由壳层复位）。
    in-out property <bool> logs-export-armed: false;
    callback export-logs-requested();

    // —— D61 旧版库一键迁移 ——
    // 仅在检测到 exe 旁遗留库（或未收账的迁移备份）时出现于设置面板；
    // detail 是检测文案（文件数/体量），busy 期间按钮禁用（与导入互斥）。
    in property <bool> migrate-legacy-available: false;
    // D64 已完成态：旧库已全部收账时迁移区不隐身——展示留档位置供找回。
    in property <bool> migrate-legacy-done: false;
    in property <string> migrate-legacy-backup-path: "";
    in property <string> migrate-legacy-detail: "";
    in property <bool> migrate-legacy-busy: false;
    callback migrate-legacy-requested();
    callback open-migration-backup-requested();

    // —— D56 更新检查 ——
    // app-version 是壳层注入的当前版本（"v0.1.0"）；status-text 是设置面板
    // 「关于」区状态行（danger 决定是否着错误色）；badge 是设置齿轮上的
    // 未处理更新点。弹窗 open/shown 两段式（同 classify），内容由壳层回填。
    in property <string> app-version: "";
    in property <bool> update-checking: false;
    in property <string> update-status-text: "";
    in property <bool> update-status-danger: false;
    in property <bool> update-badge: false;
    in property <bool> update-open: false;
    in property <bool> update-shown: false;
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <string> update-url: "";
    // D70 应用内自更新：下载进度与四态弹窗（初始/下载中/启动中/失败）。
    in property <bool> update-downloading: false;
    in property <bool> update-launching: false;
    in property <float> update-progress: 0.0;
    in property <string> update-progress-text: "";
    in property <string> update-apply-error: "";
    callback update-check-requested();
    callback update-open-release-page();
    callback update-skip-version();
    callback update-install-requested();
    callback update-cancel-install();

    // 目标提示：讲「现在能不能上框、下一步该点哪里」，不说内部状态名
    //（旧文案「就绪/需确认/未选择目标」与 chip 的「未识别目标」三词一义，
    // 用户无从对应）。每档都落在一个可执行的下一步上。渲染位置紧贴目标
    // 胶囊左侧且仅在非就绪态出现（就绪态收进胶囊 Tooltip，见命令栏）。
    property <string> target-hint: root.target-mode == UiEnums.target-mode-ready
        ? "就绪 · 双击素材即可上框"
        : root.target-mode == UiEnums.target-mode-needs-confirmation
            ? "通用目标 · 首次上框需确认"
            : root.target-mode == UiEnums.target-mode-choose
                ? "点选列表中的聊天窗口"
                : "选择聊天窗口后，双击素材即可上框";

    changed content-y => {
        root.scroll-changed(root.content-y);
    }

    changed viewport-height => {
        root.viewport-resized();
    }

    changed viewport-width => {
        root.viewport-resized();
    }

    // 弹层门卫：挡板（overlay 宿主内 if root.modal-open）与键盘快捷键守卫
    // 共用的同一份「任一弹层打开」判定——单一代码事实来源，新增弹层只改这里。
    // import-result-open 不算模态（挡板同判，结果面板开着仍可操作背景）。
    property <bool> modal-open:
        root.settings-open || root.import-menu-open
        || root.target-mode == UiEnums.target-mode-choose
        || root.context-menu-open || root.move-menu-open
        || root.cat-menu-open || root.cat-rename-open
        || root.rename-open || root.properties-open
        || root.scope-menu-open || root.classify-open
        || root.target-rename-open
        || root.tuning-open
        || root.share-devices-open || root.share-offer-open
        || root.space-ctl-open || root.space-add-open
        || root.update-open;

    // 浮层全部收拢后把焦点还给壳层根：弹窗输入框随条件元素销毁会清空焦点，
    // 不归还则 Esc/Ctrl+A/Ctrl+V 全局通道静默失效（契约 §2.2「关闭后焦点归还」）。
    // 触发控件多为瓦片/菜单项等不可稳定聚焦的元素，回根是无歧义的落点。
    changed modal-open => {
        if (!root.modal-open) {
            key-root.focus();
        }
    }

    // 「界面动画」开关同步到共享 Motion 令牌：theme.slint 里的原语读不到本组件
    // 属性，统一经 Motion.enabled 把全部 animate 时长钳到 0（契约 §1.4）。
    init => {
        Motion.enabled = root.animations-enabled;
    }
    changed animations-enabled => {
        Motion.enabled = root.animations-enabled;
    }

    // overlay 宿主：填满窗口。内层先放常规布局，再叠绝对定位浮层。
    // D47 键盘通道：capture 只留 Esc——「关弹层」是否决类动作，必须永远赢。
    // Ctrl+A / Ctrl+V 走非 capture 的 key_pressed 兜底：持焦 TextInput 原生
    // 消费 Ctrl+A/Ctrl+C/Ctrl+V/X（1.17.1 items/text.rs StandardShortcut 分支），
    // 这些键到不了这里，无需任何「输入框持焦让路」机关；弹层打开时默认动作
    // 让位（modal-open 门卫），杜绝快捷键打进下层视图。壳层启动时 focus() 一次
    //（见 main.rs）：无焦点时按键不会送达 key-root，兜底链路必须有主。
    key-root := FocusScope {
        focus-on-click: false;

        capture_key_pressed(event) => {
            if (event.text == Key.Escape) {
                if root.notice-history-open {
                    root.notice-history-open = false;
                    return accept;
                }
                root.escape-pressed();
                return accept;
            }
            return reject;
        }

        key_pressed(event) => {
            if (event.modifiers.control && (event.text == "a" || event.text == "A")
                && !root.modal-open) {
                root.key-a-pressed();
                return accept;
            }
            if (event.modifiers.control && (event.text == "v" || event.text == "V")
                && !root.modal-open) {
                root.paste-import-requested();
                return accept;
            }
            return reject;
        }

        Rectangle {
        // FocusScope 不是 Window，子元素不会被自动拉伸：显式铺满。
        // （外层 Rectangle 的「勿写 100%」告诫只针对 Window 根——那会反向
        // 钳制窗口可拖尺寸；这里几何由 FocusScope 决定，100% 是安全的。）
        width: 100%;
        height: 100%;

        // 全量重绘哨兵：垫在所有内容之下，透明无 TouchArea（不参与布局、
        // 不挡输入）。repaint-nudge 翻转带动 opacity 变化；Opacity 类项在
        // 脏区计算里命中「变化即刷新整棵子树」分支（partial_renderer.rs
        // must_refresh_children），故其自身几何 = 全窗 ⇒ 一帧全量重绘。
        // 两档透明度差 0.1%，肉眼不可感知。
        Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;
            opacity: root.repaint-nudge ? 1.0 : 0.999;
        }

        VerticalLayout {
            // 单行命令栏（原「工具栏 + 目标条」两行合并，省下 52px 给内容区）。
            // 一行三个信息区按工作流排布：左「在看什么」（计数 · 视图）→ 中「找」
            // （融合式检索器）→ 右「上框去哪」（目标胶囊，核心链路升格进主栏）。
            // 不写 alignment:start：默认 stretch 下弹性占位才能吃掉剩余宽度，
            // 把右簇推到最右（alignment:start 会把所有元素压到左半边）。
            Rectangle {
                height: Metrics.bar;
                background: Theme.bg-bar;

                HorizontalLayout {
                    padding-left: Spacing.bar-pad;
                    padding-right: Spacing.bar-pad;
                    spacing: Spacing.md;

                    // —— 左簇：视图读数。计数为主、当前视图为次，句子式黏排
                    //（中点隔开）——旧 chip 描边删掉：计数和视图本是一句话的两段。
                    // 原左端 layers 图标与窗口标题栏 logo 重复，一并删。
                    Text {
                        text: root.total-text;
                        vertical-alignment: center;
                        color: Theme.text;
                        font-size: Typography.display;
                        font-weight: Typography.semibold;
                    }

                    Text {
                        text: "·";
                        vertical-alignment: center;
                        color: Theme.text-3;
                        font-size: Typography.body;
                    }

                    Text {
                        text: root.filter-label;
                        vertical-alignment: center;
                        color: Theme.text-2;
                        font-size: Typography.body;
                        overflow: elide;
                        max-width: 240px;
                    }

                    // —— 检索器（融合胶囊）：放大镜 + 范围段 + 输入区收进同一个
                    // 描边容器，消灭旧版「图标 + 范围chip + 输入框」三件套的框中框，
                    // 也消掉与左簇视图「全部」的同词异义并置（此处的全部明确隶属于
                    // 搜索）。宽度弹性 150–320px，窄窗先压检索器；高度显式钉 30px
                    //（不钉会被 HorizontalLayout 纵向拉满整行，真机截图教训）。
                    search-capsule := Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: Metrics.control;
                        min-width: 150px;
                        max-width: 320px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: root.scope-menu-open || search-input.has-focus ? Theme.accent
                            : capsule-hover.has-hover ? Theme.line-strong : Theme.line;
                        background: Theme.bg-input;

                        animate border-color { duration: Motion.enabled ? Motion.state : 0ms; easing: ease-out; }

                        // 垫底探针：悬停提亮描边；点空白处把焦点交给输入区。
                        // 声明在最前（最底层），不抢范围段/输入区的命中。
                        capsule-hover := TouchArea {
                            mouse-cursor: MouseCursor.text;
                            clicked => {
                                search-input.focus();
                            }
                        }

                        Icon {
                            x: Spacing.md;
                            y: (parent.height - self.height) / 2;
                            commands: Glyph.search;
                            tint: search-input.has-focus ? Theme.accent : Theme.text-3;
                            width: 13px;
                            height: 13px;
                        }

                        // 范围段：点击弹四选一菜单（壳层缓存查询，切档即重跑）。
                        // 元素名保留 scope-anchor：范围菜单浮层按其绝对坐标锚定。
                        scope-anchor := Rectangle {
                            x: 27px;
                            y: 0;
                            height: parent.height;
                            width: scope-text.preferred-width + 17px;

                            scope-text := Text {
                                y: (parent.height - self.height) / 2;
                                text: root.search-scope == 1 ? "文件名"
                                    : root.search-scope == 2 ? "分类"
                                    : root.search-scope == 3 ? "标签"
                                    : "全部";
                                color: root.scope-menu-open ? Theme.accent : Theme.text-2;
                                font-size: Typography.label;
                                vertical-alignment: center;
                            }

                            Icon {
                                x: scope-text.preferred-width + 3px;
                                y: (parent.height - self.height) / 2;
                                width: 10px;
                                height: 10px;
                                commands: Glyph.chevron-down;
                                tint: Theme.text-3;
                            }

                            TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.scope-menu-toggled();
                                }
                            }

                            Tooltip {
                                text: @markdown("搜索范围：全部=名称+分类+标签；其余档位只搜对应名称");
                            }
                        }

                        // 范围段与输入区之间的发丝分隔。
                        Rectangle {
                            x: scope-anchor.x + scope-anchor.width + 1px;
                            y: (parent.height - self.height) / 2;
                            width: 1px;
                            height: 14px;
                            background: Theme.line;
                        }

                        search-input := TextInput {
                            x: scope-anchor.x + scope-anchor.width + Spacing.md;
                            y: (parent.height - self.height) / 2;
                            width: parent.width - self.x - Spacing.md;
                            height: 18px;
                            font-size: Typography.body;
                            color: Theme.text;
                            selection-background-color: Theme.accent-soft;
                            selection-foreground-color: Theme.text;
                            text <=> root.search-text;
                            // 1.17.1 的 TextInput.edited 无参（区别于 LineEdit），
                            // 文本经 self.text 转发。
                            edited => {
                                root.search-changed(self.text);
                            }
                        }

                        // 占位说明：TextInput 无内建 placeholder，空文本时补一行；
                        // IME 组合串（preedit）非空时也要隐藏，否则拼音叠在灰字上。
                        if root.search-text == "" && search-input.preedit-text == "": Text {
                            x: search-input.x + 1px;
                            width: search-input.width;
                            y: (parent.height - self.height) / 2;
                            text: root.search-scope == 1 ? "搜索文件名"
                                : root.search-scope == 2 ? "搜索分类名"
                                : root.search-scope == 3 ? "搜索标签名"
                                : "搜索名称、分类或标签";
                            color: Theme.text-3;
                            font-size: Typography.body;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // 弹性占位把右簇推到最右；检索器同时参与拉伸（150–320px），
                    // 富余宽度优先给检索器，其余落到这里。
                    Rectangle {
                        horizontal-stretch: 2;
                    }

                    // D47 顶栏「多选」：进入/退出多选模式的显式入口。
                    select-anchor := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 62px;
                        height: Metrics.control;

                        select-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.select-mode-toggled();
                            }
                        }

                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: root.select-mode-active ? Theme.accent
                                : select-touch.has-hover ? Theme.line-strong : Theme.line;
                            background: root.select-mode-active ? Theme.accent-soft
                                : select-touch.pressed ? Theme.bg-raised-press
                                : select-touch.has-hover ? Theme.bg-raised-hover : Theme.bg-raised;
                            animate background, border-color { duration: Motion.enabled ? Motion.fast : 0ms; easing: ease-out; }

                            HorizontalLayout {
                                padding-left: Spacing.md;
                                padding-right: Spacing.md;
                                spacing: Spacing.sm;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    commands: root.select-mode-active ? Glyph.close : Glyph.check;
                                    tint: root.select-mode-active ? Theme.accent : Theme.text-2;
                                    width: 12px;
                                    height: 12px;
                                }
                                select-label := Text {
                                    text: root.select-mode-active ? "取消" : "多选";
                                    color: root.select-mode-active ? Theme.accent : Theme.text-2;
                                    font-size: Typography.label;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Tooltip {
                            text: @markdown("多选模式：期间单击=选中/取消，上框动作屏蔽（Esc 退出）");
                        }
                    }

                    // —— 目标胶囊（核心链路 D13 的常驻入口）：靶心图标 + 状态点 +
                    // 目标名 + 展开箭头，与「锁定仓」熔进同一枚胶囊——内部 1px 发丝线
                    // 把「换目标」「锁目标」分成两个命中区，外观读作一件事：
                    // 「上框去哪、锁不锁」。choose 态描边转 accent 催促选择。
                    target-chip := Rectangle {
                        property <bool> lock-enabled: root.target-mode != UiEnums.target-mode-empty;
                        property <string> lock-tip: lock-touch.has-hover
                            ? (root.target-pinned
                                ? "已锁定：只上框到这个窗口，不随前台切换"
                                : "未锁定：自动跟随最近使用的 IM 窗口")
                            : root.target-mode == UiEnums.target-mode-ready
                                ? "已就绪 · 双击素材即可上框"
                                : "切换上框目标窗口";

                        y: (parent.height - self.height) / 2;
                        height: Metrics.control;
                        width: Math.max(170px, Math.min(300px, target-label.preferred-width + 104px));
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: root.target-mode == UiEnums.target-mode-choose ? Theme.accent
                            : chip-touch.has-hover ? Theme.line-strong
                            : Theme.line;
                        background: chip-touch.pressed ? Theme.bg-raised-press
                            : chip-touch.has-hover ? Theme.bg-raised-hover
                            : Theme.bg-raised;

                        animate background, border-color { duration: Motion.enabled ? Motion.state : 0ms; easing: ease-out; }

                        HorizontalLayout {
                            padding-left: Spacing.lg;
                            padding-right: Metrics.lock-area + Spacing.md;
                            spacing: Spacing.sm;

                            Icon {
                                y: (parent.height - self.height) / 2;
                                commands: Glyph.target;
                                tint: root.target-mode == UiEnums.target-mode-choose ? Theme.accent : Theme.text-3;
                                width: 13px;
                                height: 13px;
                            }

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 7px;
                                height: 7px;
                                border-radius: self.width / 2;
                                background: root.target-health == UiEnums.target-health-green ? Theme.ok
                                    : root.target-health == UiEnums.target-health-yellow ? Theme.warn
                                    : root.target-health == UiEnums.target-health-red ? Theme.danger
                                    : Theme.text-3;
                            }

                            target-label := Text {
                                text: root.target-label;
                                horizontal-stretch: 1;
                                color: Theme.text;
                                font-size: Typography.body;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Icon {
                                y: (parent.height - self.height) / 2;
                                commands: root.target-mode == UiEnums.target-mode-choose ? Glyph.chevron-up : Glyph.chevron-down;
                                tint: Theme.text-3;
                                width: 12px;
                                height: 12px;
                            }
                        }

                        // 胶囊主体的命中区（声明在锁定仓之下：仓区点击归仓——
                        // press 只投最顶层元素）。
                        chip-touch := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.target-chip-clicked();
                            }
                        }

                        // 锁定仓：胶囊右端 30px 独立命中区（分隔线 + 锁形图标）。
                        Rectangle {
                            x: parent.width - self.width;
                            y: 0;
                            width: Metrics.lock-area;
                            height: parent.height;

                            Rectangle {
                                x: 0;
                                y: (parent.height - self.height) / 2;
                                width: 1px;
                                height: 14px;
                                background: Theme.line;
                            }

                            Icon {
                                x: (parent.width - self.width) / 2 + 1px;
                                y: (parent.height - self.height) / 2;
                                commands: root.target-pinned ? Glyph.lock : Glyph.unlock;
                                tint: !target-chip.lock-enabled ? Theme.text-3
                                    : root.target-pinned ? Theme.accent : Theme.text-2;
                                width: 13px;
                                height: 13px;
                            }

                            lock-touch := TouchArea {
                                enabled: target-chip.lock-enabled;
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.target-pin-toggled();
                                }
                            }
                        }

                        // 单枚 Tooltip 按悬停分区讲当下的话术：仓上讲锁定，
                        // 其余讲就绪/切换——只放一枚，避免同位两枚互相覆盖。
                        // @markdown 只吃字符串字面量，动态话术先落属性再插值。
                        // 单枚 Tooltip 按悬停分区讲当下的话术：仓上讲锁定，
                        // 其余讲就绪/切换——只放一枚，避免同位两枚互相覆盖。
                        // 话术落 target-chip.lock-tip 再插值：@markdown 只吃
                        // 字符串字面量，且自定义属性直接挂在 Tooltip 上会在
                        // 编译期触发 NamedReference 死元素 panic（1.17.1 实测）。
                        Tooltip {
                            text: @markdown("\{target-chip.lock-tip}");
                        }
                    }

                    // D90 共享空间管理入口（创建/清单/邀请码；取代 M1/M2 共享中心）。
                    face-anchor := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: Metrics.icon-button;
                        height: Metrics.icon-button;

                        IconButton {
                            glyph: Glyph.share;
                            tip: "共享空间：创建或加入团队空间，把素材共享给同事";
                            active: root.space-ctl-open;
                            clicked => {
                                root.space-manage-open-requested();
                            }
                        }
                    }

                    settings-anchor := Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: Metrics.icon-button;
                        height: Metrics.icon-button;

                        IconButton {
                            glyph: Glyph.sliders;
                            tip: "设置：上框触发方式、发送行为、渲染后端";
                            active: root.settings-open;
                            clicked => {
                                root.settings-toggled();
                            }
                        }

                        // D56 未处理更新角标：红点压齿轮右上角，开面板看详情。
                        // 8px 是「余光可辨」的下限——再小就在高亮描边旁隐身了。
                        if root.update-badge: Rectangle {
                            x: parent.width - 9px;
                            y: 1px;
                            width: 8px;
                            height: 8px;
                            border-radius: self.width / 2;
                            background: Theme.danger;
                            border-width: 1px;
                            border-color: Theme.bg-bar;
                        }
                    }
                }

                // 目标提示（仅不在就绪态时出现）：绝对定位悬在中段弹性区、
                // 右对齐「选择」按钮，紧邻右侧的目标胶囊——先读说明再读控件，
                // 修掉旧版把提示放逐到行尾最右缘的阅读断裂。就绪态不渲染：
                // 绿点即「就绪」，完整话术收进胶囊 Tooltip。
                // 刻意不进 HorizontalLayout：1.17.1 布局器里 Text 的 min 一直
                // 是文本 preferred（min-width: 0 压不动），高 DPI 窄窗上会把
                // 右簇整个挤出窗外（真窗冒烟实测）；悬在布局外后宽度由左右
                // 邻居位置钳定，随窗口收缩，不参与布局求解。
                if root.target-mode != UiEnums.target-mode-ready: Text {
                    x: select-anchor.x - self.width - 8px;
                    y: (parent.height - self.height) / 2;
                    width: Math.min(220px, Math.max(0px, select-anchor.x - search-capsule.x - search-capsule.width - 24px));
                    text: root.target-hint;
                    horizontal-alignment: right;
                    color: Theme.text-3;
                    font-size: Typography.label;
                    overflow: elide;
                }

                // 栏底发丝线：单栏化后与内容区（bg-panel）的分界靠它立住。
                Rectangle {
                    y: parent.height - self.height;
                    width: 100%;
                    height: 1px;
                    background: Theme.line;
                }
            }

            if root.notice-banner != "": InlineNotice {
                text: root.notice-banner;
                action-label: "重试刷新";
                action => { root.refresh-library-requested(); }
            }
            if root.progress-visible: Rectangle {
                height: Metrics.control-primary;
                background: Theme.bg-panel;

                HorizontalLayout {
                    padding-left: Spacing.bar-pad;
                    padding-right: Spacing.bar-pad;
                    spacing: Spacing.lg;
                    alignment: start;

                    ProgressIndicator {
                        y: (parent.height - self.height) / 2;
                        width: 200px;
                        height: 4px;
                        progress: root.progress-percent;
                    }

                    Text {
                        text: root.progress-text;
                        color: Theme.text-2;
                        font-size: Typography.label;
                        vertical-alignment: center;
                    }
                }
            }

            // 主体：左分类侧栏 + 中央瀑布流网格（参考千牛「我的表情」排版）。
            HorizontalLayout {
                // 这一行吃掉窗口的全部剩余高度：其余行都是固定高，若此行不显式拉伸，
                // 顶层 VerticalLayout 的最大高度会被算成各行之和（有限值），
                // Windows 便据此把窗口最大可拖高度钳在内容高度上，导致纵向拉不动。
                vertical-stretch: 1;
                // 交叉轴（垂直）max 会取子项 max 的最小值；子项里若有有限 max，会把
                // 整窗最大可拖高度钳在内容高度上。显式抬高本行的 max-height，解除该钳制。
                max-height: 100000px;
                // 左侧分类侧栏（垂直列表 + 底部素材库维护）。
                // 宽度可拖（150–420px）：实时值在 sidebar-width，松手持久化。
                Rectangle {
                    width: Math.min(root.max-sidebar-width, Math.max(root.min-sidebar-width, root.sidebar-width));
                    background: Theme.bg-panel;

                    VerticalLayout {
                        // D90 作用域头：主库视图 = 「分类」标签；空间视图 = 空间
                        // 身份行（点击返回我的素材，当前空间一眼可辨）。
                        if root.in-space-view: Rectangle {
                            height: 36px;
                            background: scope-back.has-hover ? Theme.bg-raised : Theme.accent-soft;

                            HorizontalLayout {
                                padding-left: Spacing.xl;
                                padding-right: Spacing.xl;
                                spacing: Spacing.sm;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    commands: Glyph.share;
                                    tint: Theme.accent;
                                    width: 13px;
                                    height: 13px;
                                }

                                Text {
                                    text: root.filter-label;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    color: Theme.text;
                                    font-size: Typography.body;
                                    overflow: elide;
                                }
                            }

                            scope-back := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.space-exit-requested();
                                }
                            }
                        }

                        if !root.in-space-view: SectionLabel {
                            x: Spacing.xl;
                            height: Metrics.row-compact;
                            text: "分类";
                        }

                        // 分类列表：可滚动。
                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.visible-width;
                            viewport-height: cat-list.preferred-height;

                            cat-list := VerticalLayout {
                                padding-bottom: 8px;

                                for name[i] in root.categories: Rectangle {
                                    height: 36px;
                                    background: (i - 1) == root.selected-category ? Theme.accent-soft
                                        : (cat-touch.has-hover ? Theme.bg-raised : transparent);

                                    animate background { duration: Motion.enabled ? Motion.fast : 0ms; easing: ease-out; }

                                    // 选中态左侧强调条。
                                    Rectangle {
                                        x: 0;
                                        width: 3px;
                                        height: parent.height;
                                        background: (i - 1) == root.selected-category ? Theme.accent : transparent;
                                    }

                                    HorizontalLayout {
                                        padding-left: Spacing.xl;
                                        padding-right: Spacing.xl;
                                        spacing: Spacing.sm;

                                        Text {
                                            text: name;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            color: (i - 1) == root.selected-category ? Theme.text : Theme.text-2;
                                            font-size: Typography.body;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: i < root.category-counts.length ? root.category-counts[i] : "";
                                            vertical-alignment: center;
                                            color: Theme.text-3;
                                            font-size: Typography.caption;
                                        }
                                    }

                                    cat-touch := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => {
                                            root.filter-selected(i - 1);
                                        }
                                        // D84 分类右键菜单：up 右键带命中分类名与
                                        // 窗口坐标（同瓦片右键取坐标手法）。
                                        // 「全部」(i=0) 不是用户分类，不弹菜单。
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.up
                                                && ev.button == PointerEventButton.right
                                                && i > 0) {
                                                root.cat-right-click(name,
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // D46 回收站入口（侧栏系统分类项）：选中 = 专用 Trash 视图。
                        // D90：空间库没有本地回收站（移出 = 直删），空间视图整行隐藏。
                        if !root.in-space-view: Rectangle {
                            height: 36px;
                            background: root.selected-category == -3 ? Theme.accent-soft
                                : (trash-touch.has-hover ? Theme.bg-raised : transparent);
                            animate background { duration: Motion.enabled ? Motion.fast : 0ms; easing: ease-out; }

                            Rectangle {
                                x: 0;
                                width: 3px;
                                height: parent.height;
                                background: root.selected-category == -3 ? Theme.accent : transparent;
                            }

                            HorizontalLayout {
                                padding-left: Spacing.xl;
                                padding-right: Spacing.xl;
                                spacing: Spacing.sm;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    commands: Glyph.trash;
                                    tint: root.selected-category == -3 ? Theme.accent : Theme.text-3;
                                    width: 13px;
                                    height: 13px;
                                }

                                Text {
                                    text: "回收站";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    color: root.selected-category == -3 ? Theme.text : Theme.text-2;
                                    font-size: Typography.body;
                                }

                                Text {
                                    text: root.trash-count > 0 ? root.trash-count : "";
                                    vertical-alignment: center;
                                    color: Theme.text-3;
                                    font-size: Typography.caption;
                                }
                            }

                            trash-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.filter-selected(-3);
                                }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: Theme.line;
                        }

                        // —— D90 共享空间段：行 = 已加入空间，点击进入（换根浏览）——
                        SectionLabel {
                            x: Spacing.xl;
                            height: Metrics.row-compact;
                            text: "共享空间";
                        }

                        for space[i] in root.space-rows: Rectangle {
                            height: 36px;
                            background: i == root.selected-space ? Theme.accent-soft
                                : (space-touch.has-hover ? Theme.bg-raised : transparent);
                            animate background { duration: Motion.enabled ? Motion.fast : 0ms; easing: ease-out; }

                            Rectangle {
                                x: 0;
                                width: 3px;
                                height: parent.height;
                                background: i == root.selected-space ? Theme.accent : transparent;
                            }

                            HorizontalLayout {
                                padding-left: Spacing.xl;
                                padding-right: Spacing.xl;
                                spacing: Spacing.sm;

                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    commands: Glyph.share;
                                    tint: i == root.selected-space ? Theme.accent : Theme.text-3;
                                    width: 13px;
                                    height: 13px;
                                }

                                Text {
                                    text: space.name;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    color: i == root.selected-space ? Theme.text : Theme.text-2;
                                    font-size: Typography.body;
                                    overflow: elide;
                                }

                                Text {
                                    text: space.sub-label;
                                    vertical-alignment: center;
                                    color: Theme.text-3;
                                    font-size: Typography.caption;
                                }
                            }

                            space-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.space-picked(space.id);
                                }
                                Tooltip {
                                    text: @markdown("共享空间：素材已同步到本地，**双击即可发给客户**");
                                }
                            }
                        }

                        // 空状态：一次点击直达创建/加入（管理弹窗）。
                        if root.space-rows.length == 0: Rectangle {
                            height: 36px;
                            background: space-empty-touch.has-hover ? Theme.bg-raised : transparent;

                            HorizontalLayout {
                                padding-left: Spacing.xl;
                                padding-right: Spacing.xl;

                                Text {
                                    text: "+ 创建或加入空间";
                                    vertical-alignment: center;
                                    color: Theme.text-3;
                                    font-size: Typography.body;
                                }
                            }

                            space-empty-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.space-manage-open-requested();
                                }
                            }
                        }

                        // —— 素材库维护区：导入常驻（空间视图 = 向空间投放素材，
                        // id 锚点不得进条件块——导入菜单浮层要跨作用域引用）；
                        // 导出是主库概念，空间视图隐藏 ——
                        VerticalLayout {
                            padding: Spacing.lg;
                            spacing: Spacing.md;

                            SectionLabel {
                                height: 18px;
                                text: root.in-space-view ? "共享空间" : "素材库";
                            }

                            // 导入单入口：一个按钮弹出菜单，按来源二选一「文件 / 文件夹」。
                            // 两类来源走不同原生对话框（文件选择器选不了目录），菜单
                            // 选中后仍走同一条子进程导入管线（D11/D24 包注册表按扩展名
                            // 分发；.emo 素材包从文件入口混选，不再单列）。
                            import-anchor := Rectangle {
                                height: Metrics.control;

                                Button {
                                    width: 100%;
                                    height: 100%;
                                    text: "导入素材…";
                                    primary: true;
                                    clicked => {
                                        root.import-menu-toggled();
                                    }
                                }
                            }

                            if !root.in-space-view: Button {
                                height: Metrics.control;
                                text: "导出为 .emo…";
                                clicked => {
                                    root.export-emo-requested();
                                }
                            }

                            // 清空素材库已迁到设置 → 危险操作（D86）：侧栏左下角
                            // 紧邻导入/导出，误触代价是整库不可逆丢失。
                        }
                    }
                }

                // 拖宽分隔条：按住左右拖调整分类侧栏宽度，松手发 sidebar-resize-ended。
                Rectangle {
                    width: 8px;

                    divider-line := Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: divider-touch.pressed || divider-touch.has-hover ? 2px : 1px;
                        height: parent.height;
                        background: divider-touch.pressed ? Theme.accent
                            : divider-touch.has-hover ? Theme.line-strong
                            : Theme.line;

                        animate width, background { duration: Motion.enabled ? Motion.fast : 0ms; easing: ease-out; }
                    }

                    divider-touch := TouchArea {
                        mouse-cursor: MouseCursor.col-resize;
                        property <length> press-x: 0px;
                        property <length> start-width: 0px;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                press-x = self.mouse-x;
                                start-width = root.sidebar-width;
                            }
                            if (event.kind == PointerEventKind.up) {
                                root.sidebar-resize-ended(root.sidebar-width);
                            }
                        }

                        moved => {
                            root.sidebar-width = Math.min(root.max-sidebar-width,
                                Math.max(root.min-sidebar-width,
                                    start-width + self.mouse-x - press-x));
                        }
                    }

                    Tooltip {
                        text: @markdown("拖动调整分类栏宽度");
                    }
                }

                // 中央虚拟化网格：Flickable + 绝对定位瓦片。
                flick := Flickable {
                    horizontal-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: Math.max(root.content-height, self.height);
                    viewport-y <=> root.content-y;

                    Rectangle {
                        width: flick.viewport-width;
                        height: flick.viewport-height;

                        // 按类别切卡片表现（ImageCard / TextCard / VideoCard 合体）：
                        // - image/video：缩略图铺满（video 额外画右上角徽标）；
                        // - text：单行正文卡（D88），统一高度由 VM 布局层给定；
                        // - other：中央图标，占位色块可辨识。
                        for tile in root.tiles: Rectangle {
                            x: tile.x;
                            y: tile.y;
                            width: tile.w;
                            height: tile.h;
                            // 文本卡走主题中性底（随机色块自 D88 退场）；其余类别
                            // 保留 palette 兜底色（缺图时仍可辨识可点）。
                            background: tile.kind == UiEnums.card-kind-text
                                ? Theme.bg-raised
                                : tile.color;
                            // 文本行降 4px 圆角档：28px 高的行配 8px 圆角显药丸感
                            // （D88 复盘二轮）；图片/视频大卡维持 8px。
                            border-radius: tile.kind == UiEnums.card-kind-text
                                ? Theme.radius
                                : Theme.radius-lg;
                            clip: true;

                            // 图像/视频：缩略图铺满（视频抽帧也走同一产物）。
                            if tile.kind == UiEnums.card-kind-image || tile.kind == UiEnums.card-kind-video: Image {
                                width: 100%;
                                height: 100%;
                                source: tile.thumb;
                                image-fit: cover;
                                // D53 瓦片淡入：缺图补齐时 thumb-fade 翻转播淡入；
                                // 挂载即有图（缓存命中）时初值就是 1，不重播。
                                opacity: tile.thumb-fade ? 1.0 : 0.0;
                                animate opacity {
                                    duration: Motion.enabled ? Motion.enter : 0ms;
                                    easing: ease-out;
                                }
                            }

                            // 文件卡没有缩略图，加一层随主题翻转的色罩，保证两套
                            // 主题下图标对比度都达标（文本卡自 D88 起有专属底色，不再罩）。
                            if tile.kind == UiEnums.card-kind-other: Rectangle {
                                width: 100%;
                                height: 100%;
                                background: Theme.tile-veil;
                            }

                            // 文本：全宽行列表卡（D88 两轮复盘定稿）——占满瀑布流
                            // 整个显示区域宽度（布局层 FullRow），高度统一 28px。
                            // 排版遵循列表行（list-row）准则：连续文本行由布局层
                            // 6px 紧行距构成「列表块」（与图片网格 12px 交界，间距
                            // 本身区分同组/换组）；行圆角降 4px 档（短行配大圆角
                            // 显药丸感）。行内三区固定：图标 + 名区（固定宽、
                            // 表格化对齐——正文从同一 x 起步）+ 1px 竖分隔线 +
                            // 正文/片段；名与正文字号同档（body），靠色彩深浅与
                            // 分隔线分区，不靠「凑近猜」。片段数据侧按「内宽 −
                            // 行内链路 − 固定名区」预算裁剪（1.17.1 布局器里 Text
                            // 的 min 恒为 preferred，超宽不会 elide），preferred-width
                            // 绑定 + 内层 elide 只是残余兜底。
                            if tile.kind == UiEnums.card-kind-text: Rectangle {
                                width: 100%;
                                height: 100%;

                                // 名区固定宽：卡宽 18%，钳 [150, 240]px——与
                                // ui_viewmodels::name_zone_px 同公式，两侧常量
                                // 必须逐字一致。不随单行名字长短变化（对齐扫描）。
                                property <length> name-w: Math.min(
                                    Math.max(parent.width * 0.18, 150px), 240px);
                                // 行内链路 = 图标 13 + 图标-名距 6 + 名-正文距 8，
                                // 与 thumbs.rs 的 TILE_TEXT_INLINE_CHROME 逐字对齐。
                                // 注意此处不能写 parent.name-w——本层属性声明里的
                                // parent 已是外层卡片。
                                property <length> content-x:
                                    Spacing.md + 13px + 6px + name-w + 8px;

                                Icon {
                                    x: Spacing.md;
                                    y: (parent.height - self.height) / 2;
                                    commands: Glyph.file-text;
                                    tint: Theme.card-icon;
                                    width: 13px;
                                    height: 13px;
                                }

                                name-text := Text {
                                    x: Spacing.md + 19px;
                                    width: parent.name-w;
                                    height: 100%;
                                    text: tile.label;
                                    color: Theme.text-3;
                                    font-size: Typography.body;
                                    font-weight: Typography.medium;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                // 竖分隔线：名区与正文的 UI 分界（坐在 8px 区距正中）。
                                Rectangle {
                                    x: parent.content-x - 5px;
                                    y: 6px;
                                    width: 1px;
                                    height: parent.height - 12px;
                                    background: Theme.line-strong;
                                }

                                if tile.search-segments.length == 0: Text {
                                    x: parent.content-x;
                                    width: parent.width - self.x - Spacing.md;
                                    height: 100%;
                                    text: tile.preview;
                                    color: Theme.text-2;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                if tile.search-segments.length > 0: Rectangle {
                                    x: parent.content-x;
                                    width: parent.width - self.x - Spacing.md;
                                    height: 100%;

                                    HorizontalLayout {
                                        height: 100%;
                                        alignment: start;

                                        for seg in tile.search-segments: Rectangle {
                                            preferred-width: seg-text.preferred-width;
                                            background: seg.hit ? Theme.accent-soft : transparent;
                                            border-radius: Spacing.xxs;

                                            seg-text := Text {
                                                width: 100%;
                                                height: 100%;
                                                text: seg.text;
                                                color: Theme.text-2;
                                                font-size: Typography.body;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // D91 一致性角标（文本行卡）：右缘竖居中小点。
                                // 内容宽的 elide 兜底留有 Spacing.md 余量，点坐进
                                // 右缘不遮命中文本；缺失红 / 已修改黄，与图片瓦片
                                // 同一语义对。
                                if tile.missing || tile.stale: Rectangle {
                                    x: parent.width - self.width - Spacing.xs;
                                    y: (parent.height - self.height) / 2;
                                    width: 6px;
                                    height: 6px;
                                    border-radius: self.width / 2;
                                    border-width: 1px;
                                    border-color: Theme.badge-ring;
                                    background: tile.missing ? Theme.danger : Theme.warn;
                                }
                            }

                            // 其他（归档/未知）：中央图标占位，仍可点选上框（Files 兜底）。
                            if tile.kind == UiEnums.card-kind-other: Rectangle {
                                width: 100%;
                                height: 100%;

                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Glyph.file;
                                    tint: Theme.card-icon;
                                    width: 28px;
                                    height: 28px;
                                }
                            }

                            // 右上角类型徽标：小胶囊 + 类别图标，图片/视频/文件三类
                            // 统一示意（文本卡自 D88 复盘起走行内名条自带 file-text
                            // 图标，28px 行高放不下 22px 胶囊，退场）。
                            // 旧版是全宽透明文字横条——遮缩略图、图片类缺失，
                            // 且胶囊宽度没钉死会撑满整卡（本条即那次回归的修复）。
                            // 图形直接按 kind 从 Glyph 表取（字符串名传不进 Path，
                            // kind 与图形本就一一对应，无须经 Rust 再转一道）。
                            if tile.kind != UiEnums.card-kind-text: Rectangle {
                                width: 22px;
                                height: 22px;
                                x: parent.width - self.width - 6px;
                                y: 6px;
                                border-radius: Theme.radius;
                                background: Theme.badge-bg;

                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: tile.kind == UiEnums.card-kind-image ? Glyph.image
                                        : tile.kind == UiEnums.card-kind-video ? Glyph.film
                                        : tile.kind == UiEnums.card-kind-text ? Glyph.file-text
                                        : Glyph.file;
                                    tint: Theme.badge-text;
                                    width: 13px;
                                    height: 13px;
                                }
                            }

                            // 名称条：贴底整条，hover 时压深底色让长名字更好读。
                            // 文本卡退场（D88 复盘）：28px 行高会被 20px 名条整个
                            // 盖住正文——名改行内前置，见文本卡分支。
                            if tile.label != "" && tile.kind != UiEnums.card-kind-text: Rectangle {
                                y: parent.height - self.height;
                                width: 100%;
                                height: 20px;
                                background: tile-touch.has-hover ? Theme.label-bar-bg-hover : Theme.label-bar-bg;

                                Text {
                                    x: 6px;
                                    width: parent.width - 12px;
                                    text: tile.label;
                                    color: Theme.label-bar-text;
                                    // 文件名是素材主标识，走 body 档；caption 只留给元数据。
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            // 边框覆盖层：hover 描一圈淡边，选中描 accent（多选/回收站勾选态），
                            // 最近上框的那张描 accent。选中优先于 hover。
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: transparent;
                                border-radius: Theme.radius-lg;
                                border-width: tile.selected || tile.asset-id == root.active-asset-id ? 2px
                                    : tile-touch.has-hover ? 1px
                                    : 0px;
                                border-color: tile.selected || tile.asset-id == root.active-asset-id
                                    ? Theme.accent
                                    : Theme.line-strong;
                            }

                            // 左上勾选角标：选中即现（多选模式与常态 Ctrl 选共用）。
                            if tile.selected: Rectangle {
                                x: 6px;
                                y: 6px;
                                width: 20px;
                                height: 20px;
                                border-radius: self.width / 2;
                                background: Theme.accent;

                                Icon {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    commands: Glyph.check;
                                    tint: Theme.accent-ink;
                                    width: 12px;
                                    height: 12px;
                                }
                            }

                            // D80 共享角标：右上类型徽标正下方一枚状态点（在途=accent
                            // /已送达=绿/失败=红），白描边保证在缩略图上可辨。
                            if tile.share-badge != UiEnums.share-badge-none: Rectangle {
                                x: parent.width - self.width - 8px;
                                y: 32px;
                                width: 10px;
                                height: 10px;
                                border-radius: self.width / 2;
                                border-width: 2px;
                                border-color: Theme.badge-ring;
                                background: tile.share-badge == UiEnums.share-badge-busy ? Theme.accent
                                    : tile.share-badge == UiEnums.share-badge-done ? Theme.ok
                                    : Theme.danger;
                            }

                            // D80-M1「共享中」角标：发送结果点正下方一枚紫点（位置与
                            // 颜色双重区分——可获得性在域中广播与单次传输结果语义不同）。
                            if tile.shared: Rectangle {
                                x: parent.width - self.width - 9px;
                                y: 46px;
                                width: 8px;
                                height: 8px;
                                border-radius: self.width / 2;
                                border-width: 2px;
                                border-color: Theme.badge-ring;
                                background: Theme.shared;
                            }

                            // D91 一致性角标：正本缺失（红）/被外部修改待重索引（黄）。
                            // 缺失优先——文件都不在了，「已修改」无从谈起。
                            if tile.missing || tile.stale: Rectangle {
                                x: parent.width - self.width - 9px;
                                y: 60px;
                                width: 8px;
                                height: 8px;
                                border-radius: self.width / 2;
                                border-width: 2px;
                                border-color: Theme.badge-ring;
                                background: tile.missing ? Theme.danger : Theme.warn;
                            }

                            tile-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                // D47：按下的那一刻就按住修饰键 → 本次抬笔的
                                // clicked/double-clicked（上框链路）整体作废。
                                // 判定点在 Down（clicked 先于 Up 的 pointer-event 触发，
                                // 事后挡不住）。无修饰路径 mod-on-down 恒 false，
                                // 上框信号逐字照发（红线 B：现状不变）。
                                property <bool> mod-on-down: false;

                                // D83 素材点击免激活：hover 态喂给壳层静态，
                                // 平台层在 WM_MOUSEACTIVATE 时裁决是否豁免上浮
                                // （事件驱动；激活决定先于本组件收到点击）。
                                changed has-hover => {
                                    root.tile-hover-changed(self.has-hover);
                                }

                                clicked => {
                                    if (!self.mod-on-down) {
                                        root.tile-clicked(tile.asset-id);
                                    }
                                }
                                double-clicked => {
                                    if (!self.mod-on-down) {
                                        root.double-clicked(tile.asset-id);
                                    }
                                }
                                // D47/D48：带修饰的左键抬笔走 modified-click、右键抬笔
                                // 走 right-click；无修饰左键仍由 clicked/double-clicked
                                // 承载（常态上框链路一字不动）。多选模式的普通单击
                                // 由壳层在 tile-clicked 路径里判模式改走选区切换。
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                        self.mod-on-down = event.modifiers.control || event.modifiers.shift;
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                                        root.tile-right-click(tile.asset-id,
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                        self.mod-on-down = false;
                                        if (event.modifiers.control || event.modifiers.shift) {
                                            root.tile-modified-click(tile.asset-id,
                                                event.modifiers.control, event.modifiers.shift);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // —— 浮层区（绝对定位，浮于瀑布流之上，不占垂直布局流）——

        // 空态：网格没有瓦片时，锚在网格区域中央说明「为什么空、下一步做什么」。
        if root.tiles.length == 0 && root.empty-title != "": Rectangle {
            x: flick.absolute-position.x;
            y: flick.absolute-position.y;
            width: flick.width;
            height: flick.height;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                Icon {
                    x: (parent.width - self.width) / 2;
                    commands: Glyph.empty-box;
                    tint: Theme.line-strong;
                    width: 44px;
                    height: 44px;
                }

                Text {
                    text: root.empty-title;
                    horizontal-alignment: center;
                    color: Theme.text-2;
                    font-size: Typography.title;
                    font-weight: Typography.semibold;
                }

                Text {
                    text: root.empty-hint;
                    horizontal-alignment: center;
                    color: Theme.text-3;
                    font-size: Typography.label;
                }
            }
        }

        // 浮层挡板：判定即 modal-open（与键盘快捷键守卫同一份代码事实——
        // 任一浮层打开时铺满窗口拦截背景点击（工作流弹窗下 =
        // 模态死点击，底下控件收不到；点在弹窗面板自身空白处命中挡板同理，
        // 也不触发收起）。D67 分级收口：壳层在 overlay-dismissed 里只关
        // 菜单级浮层（右键/范围/导入/移动/目标选择器）；设置/归类/重命名/
        // 属性/目标重命名/更新不再吃 dismiss——误触背景不丢输入，关闭走
        // 各自的显式按钮与 Esc。挡板不能摘：摘了背景控件恢复收点，弹窗
        // 飘着时点瓦片会误触发动作，比误关更糟。
        if root.modal-open: TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.overlay-dismissed();
            }
        }

        // IM 目标垂直下拉：锚定在目标 chip 下方。
        // 展开动画：元素挂载后 init 置 shown，opacity/y 从初始态过渡到位
        //（框架 animate，非手绘）。关闭端是 if 销毁、Slint 即时移除，无出场过渡；
        // 动画时长受「界面动画」设置钳制，关了就 0ms 直达。
        if root.target-mode == UiEnums.target-mode-choose: Rectangle {
            property <bool> shown: root.target-picker-shown;
            init => {
                root.overlay-mounted(0);
            }

            opacity: shown ? 1.0 : 0.0;
            // 锚在目标胶囊下方；胶囊已随命令栏移到窗口右缘，窄窗下 300px 浮层
            // 会右溢出窗——按右缘钳制（与右键菜单 1828 行同款手法）。
            x: Math.min(target-chip.absolute-position.x, root.width - 312px);
            y: target-chip.absolute-position.y + target-chip.height + 6px + (shown ? 0px : -6px);
            width: 300px;
            height: choices-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: Motion.enabled ? Motion.enter : 0ms; easing: ease-out; }

            choices-layout := VerticalLayout {
                padding: Spacing.menu-pad;
                spacing: Spacing.xs;

                if root.target-choices.length == 0: Rectangle {
                    height: 56px;

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: "没有检测到运行中的聊天窗口";
                            color: Theme.text-2;
                            font-size: Typography.body;
                        }

                        Text {
                            text: "先打开并登录一个聊天窗口，再回来选择";
                            color: Theme.text-3;
                            font-size: Typography.label;
                        }
                    }
                }

                for choice in root.target-choices: Rectangle {
                    height: 48px;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: choice-touch.has-hover && choice.available ? Theme.accent : Theme.line;
                    background: choice-touch.pressed ? Theme.bg-raised-press
                        : choice-touch.has-hover ? Theme.bg-raised-hover
                        : Theme.bg-raised;
                    opacity: choice.available ? 1.0 : 0.6;

                    animate background, border-color { duration: Motion.enabled ? Motion.fast : 0ms; easing: ease-out; }

                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: Spacing.sm;
                        spacing: Spacing.xxs;

                        HorizontalLayout {
                            spacing: Spacing.sm;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: self.width / 2;
                                background: choice.health == UiEnums.target-health-green ? Theme.ok
                                    : choice.health == UiEnums.target-health-yellow ? Theme.warn
                                    : choice.health == UiEnums.target-health-red ? Theme.danger
                                    : Theme.text-3;
                            }

                            Text {
                                text: choice.label;
                                horizontal-stretch: 1;
                                color: Theme.text;
                                font-size: Typography.body;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: choice.status;
                            color: Theme.text-3;
                            // 在线/需确认/已关闭是选择依据，不能压到 caption 档。
                            font-size: Typography.label;
                            overflow: elide;
                        }
                    }

                    choice-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.target-choice-selected(choice.selection-key);
                        }
                        // 右键 = 重命名该实例（D59 别名册的 UI 入口）。判定在 Down，
                        // 与左键 clicked（Up）互不干扰。
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right
                                && event.kind == PointerEventKind.down {
                                root.target-rename-requested(choice.selection-key);
                            }
                        }
                    }
                }
            }
        }

        // 目标实例重命名：别名写进 targets.json，chip 与 picker 同步显示。
        // 留空保存 = 恢复默认名（默认名回显在标题行）。
        if root.target-rename-open: Rectangle {
            x: (root.width - 340px) / 2;
            // D86 弹窗族统一居中原点：窗口过矮时至少留 16px 顶边，不跑到窗外。
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 340px;
            height: target-rename-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            target-rename-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 8px;

                TitleLabel {
                    text: "重命名目标窗口";
                }

                Text {
                    text: root.target-rename-default;
                    color: Theme.text-3;
                    font-size: Typography.label;
                    overflow: elide;
                }

                target-rename-input := DialogInput {
                    text: root.target-rename-text;
                    placeholder-text: "别名（留空保存 = 恢复默认名）";
                    accepted(text) => { root.target-rename-confirmed(text); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "取消";
                        clicked => {
                            root.target-rename-cancelled();
                        }
                    }
                    Button {
                        text: "保存";
                        primary: true;
                        clicked => {
                            root.target-rename-confirmed(target-rename-input.text);
                        }
                    }
                }
            }
        }

        // 导入菜单：左下角「导入素材…」上方弹出（向上避免越过窗口底缘）。
        if root.import-menu-open: Rectangle {
            property <bool> shown: root.import-menu-shown;
            init => {
                root.overlay-mounted(1);
            }

            opacity: shown ? 1.0 : 0.0;
            x: import-anchor.absolute-position.x;
            y: import-anchor.absolute-position.y - self.height - 8px + (shown ? 0px : 6px);
            width: 244px;
            height: import-menu-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: Motion.enabled ? Motion.enter : 0ms; easing: ease-out; }

            import-menu-layout := VerticalLayout {
                padding: Spacing.menu-pad;
                spacing: Spacing.xs;

                // 命名与「导入素材…」按钮错开：按钮是入口（弹本菜单），两项按
                // 来源命名（文件/文件夹）。.emo 不再单列：文件入口本就混选
                // .emo 素材包（D49），单独入口是与它语义重复的 D34 遗留。
                MenuItem {
                    glyph: Glyph.import;
                    text: "从文件导入…";
                    detail: "混选图片、视频、文本与 .emo 素材包";
                    clicked => {
                        root.import-files-requested();
                    }
                }

                MenuItem {
                    glyph: Glyph.folder;
                    text: "从文件夹导入…";
                    detail: "整个文件夹一次导入，默认建议按目录名新建分类";
                    clicked => {
                        root.import-requested();
                    }
                }

                // 手动刷新：重载库并重跑缩略图派生（只补缺失，已有缩略图跳过）
                //——缩略图派生被中断/工具缺失时的唯一自助恢复入口。
                MenuItem {
                    glyph: Glyph.refresh;
                    text: "刷新素材库";
                    detail: "重新载入素材并补齐缺失的缩略图";
                    clicked => {
                        root.refresh-library-requested();
                    }
                }
            }
        }

        // D51 范围菜单：锚在搜索框前缀 chip 下方；两段式动效（open 挂载 /
        // shown 翻转由壳层下一帧置位，出场先收 shown 播完再收 open）。
        if root.scope-menu-open: Rectangle {
            property <bool> shown: root.scope-menu-shown;

            opacity: shown ? 1.0 : 0.0;
            x: scope-anchor.absolute-position.x;
            y: scope-anchor.absolute-position.y + scope-anchor.height + 6px + (shown ? 0px : -6px);
            width: 168px;
            height: scope-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: Motion.enabled ? Motion.enter : 0ms; easing: ease-out; }

            scope-layout := VerticalLayout {
                padding: Spacing.menu-pad;
                spacing: Spacing.xs;

                MenuItem {
                    glyph: Glyph.search;
                    text: "全部";
                    detail: "名称 + 分类 + 标签";
                    clicked => { root.scope-selected(0); }
                }
                MenuItem {
                    glyph: Glyph.file;
                    text: "文件名";
                    detail: "只搜素材文件名";
                    clicked => { root.scope-selected(1); }
                }
                MenuItem {
                    glyph: Glyph.layers;
                    text: "分类";
                    detail: "只搜分类名";
                    clicked => { root.scope-selected(2); }
                }
                MenuItem {
                    glyph: Glyph.check;
                    text: "标签";
                    detail: "只搜标签名";
                    clicked => { root.scope-selected(3); }
                }
            }
        }

        // 设置面板：右对齐锚在设置按钮下方。高度上限 = 锚点下缘到窗底——
        // 矮窗口不再把面板底部截断或压到底部操作条后面，超出部分面板内滚动。
        if root.settings-open: Rectangle {
            property <bool> shown: root.settings-shown;
            property <length> panel-top: settings-anchor.absolute-position.y + settings-anchor.height + 6px;
            init => {
                root.overlay-mounted(2);
            }

            opacity: shown ? 1.0 : 0.0;
            x: Math.max(12px, settings-anchor.absolute-position.x + settings-anchor.width - self.width);
            y: panel-top + (shown ? 0px : -6px);
            width: 316px;
            height: Math.min(settings-scroll-col.preferred-height + 24px,
                root.height - panel-top - 12px);
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: Motion.enabled ? Motion.enter : 0ms; easing: ease-out; }

            VerticalLayout {
                padding: Spacing.panel-pad;
                spacing: Spacing.md;

                // 固定头（不随滚动）：「关闭」必须常驻——D67 起点外部不再
                // 收起本面板，显式出口只剩这个按钮和 Esc。
                HorizontalLayout {
                    spacing: 8px;
                    TitleLabel {
                        height: 20px;
                        text: "设置";
                        horizontal-stretch: 1;
                    }
                    FlatButton {
                        text: "关闭";
                        glyph: Glyph.close;
                        clicked => { root.settings-closed(); }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    viewport-height: settings-scroll-col.preferred-height;

                    settings-scroll-col := VerticalLayout {
                        spacing: 10px;

                        // 通用渲染：行数据全部来自壳层的 SettingRowData 模型（含
                        // 分区标题行），新增设置项只改 Rust 侧描述（SettingSpec）。
                        // 包裹层必须用 VerticalLayout：裸 Rectangle 不向布局上报
                        // 子内容的首选高度，整列 preferred 塌成 0、面板压缩叠行
                        // （渲染实测）；布局元素才传播子项 layout info。
                        for setting in root.settings: VerticalLayout {
                            if setting.header: SectionLabel {
                                height: 16px;
                                text: setting.title;
                            }
                            if !setting.header: SettingRow {
                                title: setting.title;
                                detail: setting.detail;
                                checked: setting.checked;
                                enabled: setting.enabled;
                                toggled => {
                                    root.setting-toggled(setting.key);
                                }
                            }
                        }

                        // D76.5 上框点位（高级）：声明了 input_point 的目标在此
                        // 列出，点开独立弹窗编辑 x/y 表达式（D76.4 曾内联展开在
                        // 面板里，选中后没有回退出口——用户反馈改弹窗）。保存 =
                        // 校验 + 写 settings.toml 覆盖层 + 热生效（优先级 设置
                        // 面板 > 手编 user.toml > 内置）；恢复默认 = 删除覆盖。
                        // 包在 VerticalLayout 内（同上方设置行：裸 Rectangle 不
                        // 传播首选高度，渲染实测）。
                        VerticalLayout {
                            spacing: Spacing.sm;

                            if root.target-tunings.length > 0: SectionLabel {
                                height: 14px;
                                text: "上框点位（高级）";
                            }

                            if root.target-tunings.length > 0: HorizontalLayout {
                                spacing: 4px;
                                for tuning in root.target-tunings: FlatButton {
                                    text: tuning.label;
                                    tip: "调整该目标「把焦点放入输入框」的点击坐标表达式；保存后该目标只使用这一个点，重置可恢复内置兜底点";
                                    clicked => { root.tuning-selected(tuning.target-id); }
                                }
                            }
                        }

                        // D38/D82 日志：定位与导出独立成组，不再挂在上框点位下
                        //（两者与上框点位无关，混排会让人以为日志也属于点位配置）。
                        VerticalLayout {
                            spacing: Spacing.sm;

                            SectionLabel {
                                height: 14px;
                                text: "日志";
                            }

                            // D38：一键定位本次会话日志（全部子进程日志同目录）。
                            FlatButton {
                                text: "定位本次日志";
                                glyph: Glyph.folder-search;
                                tip: "在资源管理器中选中本次运行的日志文件；全部进程的日志都在同一目录";
                                clicked => { root.open-logs-requested(); }
                            }

                            // D82/D86 日志导出：两段确认（第一击装填、第二击导出）——
                            // 日志正文作为文本走上框管线，目标未就绪时管线自动降级为
                            // 只复制。不再用 file 载荷：内置画像未声明 file 行（D82
                            // 红线），只复制文件永远到不了目标输入框。
                            FlatButton {
                                text: root.logs-export-armed ? "再次点击确认导出" : "日志导出";
                                glyph: Glyph.export;
                                tip: "把本次日志正文送入目标输入框（不自动发送）；没有热目标时复制到剪贴板。完整日志文件用上方「定位本次日志」";
                                clicked => {
                                    if (root.logs-export-armed) {
                                        root.logs-export-armed = false;
                                        root.export-logs-requested();
                                    } else {
                                        root.logs-export-armed = true;
                                    }
                                }
                            }
                        }

                        // D61/D64 旧版库迁移：三态——可迁移（按钮）/ 已收账
                        // （留档可见 + 打开留档目录，回应「找不到原本数据源」）/
                        // 隐藏。文案与「关于」区同款克制风格，按钮态跟着 busy 走。
                        // if 必须包在 VerticalLayout **内部**（同上方设置行）：
                        // if 直接做布局子项时首选高度不传播，详情折行后
                        // 「关于」标题会贴上来（渲染实测）。
                        VerticalLayout {
                            spacing: Spacing.sm;

                            if root.migrate-legacy-available || root.migrate-legacy-done: SectionLabel {
                                height: 14px;
                                text: "数据迁移";
                            }

                            if root.migrate-legacy-available: FlatButton {
                                text: root.migrate-legacy-busy ? "迁移中…" : "一键迁移旧版素材";
                                enabled: !root.migrate-legacy-busy;
                                tip: "把旧版存放在安装目录旁的素材搬进统一素材库：自动去重、后台补缩略图，旧目录改名留档";
                                clicked => { root.migrate-legacy-requested(); }
                            }

                            if root.migrate-legacy-done: FlatButton {
                                text: "打开旧库留档目录";
                                glyph: Glyph.folder-search;
                                tip: "旧素材已并入统一素材库，原目录改名留档在这里；确认无误后可手动删除";
                                clicked => { root.open-migration-backup-requested(); }
                            }

                            if root.migrate-legacy-available || root.migrate-legacy-done: Text {
                                text: root.migrate-legacy-detail;
                                color: Theme.text-3;
                                font-size: Typography.label;
                                wrap: word-wrap;
                            }
                        }

                        // D56「关于」：版本读数 + 手动检查 + 状态行。文案跟着
                        // VM 状态走（检查中/已是最新/发现新版本/失败原因），
                        // 失败才着 danger 色——设置面板不搞情绪化大字。
                        VerticalLayout {
                            spacing: Spacing.sm;

                            SectionLabel {
                                height: 14px;
                                text: "关于";
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: Spacing.xxs;

                                    Text {
                                        text: "素材管理器 \{root.app-version}";
                                        color: Theme.text-2;
                                        font-size: Typography.label;
                                    }
                                }

                                FlatButton {
                                    text: root.update-checking ? "检查中…" : "检查更新";
                                    enabled: !root.update-checking;
                                    tip: "连到发布源核对有没有新版本（约几秒）";
                                    clicked => { root.update-check-requested(); }
                                }
                            }

                            Text {
                                text: root.update-status-text;
                                color: root.update-status-danger ? Theme.danger : Theme.text-3;
                                font-size: Typography.label;
                                wrap: word-wrap;
                            }
                        }

                        // D86 危险操作：清空库从侧栏左下角迁到设置底部——原位置
                        // 紧邻导入/导出，误触代价是整库不可逆丢失。两段确认不变。
                        VerticalLayout {
                            spacing: Spacing.sm;

                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            SectionLabel {
                                height: 14px;
                                text: "危险操作";
                            }

                            Text {
                                text: "清空素材库会删除全部素材、缩略图与索引，且无法恢复。";
                                color: Theme.text-3;
                                font-size: Typography.caption;
                                wrap: word-wrap;
                            }

                            DangerButton {
                                text: root.clear-button-text;
                                armed: root.clear-button-armed;
                                clicked => {
                                    root.clear-library-requested();
                                }
                            }
                        }
                    }
                }
            }
        }
        // D76.5 上框点位弹窗：设置面板「上框点位（高级）」点目标进入。挂在设置
        // 面板之后 = 文档序叠其上；即时挂载（同重命名/属性弹窗，两段式动画仅
        // 菜单级）。显式出口：取消 / 保存成功 / Esc——D76.4 内联编辑无回退的
        // 教训在这里兜死。
        if root.tuning-open: Rectangle {
            x: (root.width - 340px) / 2;
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 340px;
            height: tuning-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            tuning-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 8px;

                TitleLabel {
                    text: "上框点位";
                }

                Text {
                    text: root.tuning-selected-label;
                    color: Theme.text-3;
                    font-size: Typography.label;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "x 表达式";
                            color: Theme.text-3;
                            font-size: Typography.label;
                        }
                        tuning-x-input := DialogInput {
                            text: root.tuning-x-text;
                            font-size: Typography.body;
                            placeholder-text: "如 8 或 WINDOW_WIDTH - 8";
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "y 表达式";
                            color: Theme.text-3;
                            font-size: Typography.label;
                        }
                        tuning-y-input := DialogInput {
                            text: root.tuning-y-text;
                            font-size: Typography.body;
                            placeholder-text: "如 WINDOW_HEIGHT - 8";
                            auto-focus: false;
                        }
                    }
                }

                Text {
                    text: "客户区左上角为原点，逻辑像素（96 DPI 基准）；支持 + - * / 括号与 WINDOW_WIDTH / WINDOW_HEIGHT";
                    color: Theme.text-3;
                    // 操作指令与错误说明同级，用 label 档保证小弹窗内可读。
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                if root.tuning-error != "": Text {
                    text: root.tuning-error;
                    color: Theme.danger;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    FlatButton {
                        text: "恢复默认";
                        tip: "删除本目标覆盖值，回到手编 user.toml / 内置画像的值";
                        clicked => { root.tuning-reset(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "取消";
                        clicked => {
                            root.tuning-cancelled();
                        }
                    }
                    Button {
                        text: "保存";
                        primary: true;
                        clicked => {
                            root.tuning-save(tuning-x-input.text, tuning-y-input.text);
                        }
                    }
                }
            }
        }

        // —— D48 右键菜单浮层：锚右键命中点，坐标由壳层夹取（贴边不越窗）——
        // 夹取高度随菜单行数：最多 7 行（D90 空间项 + 直发门控项）约 360px。
        if root.context-menu-open: Rectangle {
            x: Math.min(root.context-menu-x, root.width - 220px);
            y: Math.min(root.context-menu-y, root.height - 360px);
            width: 220px;
            height: menu-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            menu-layout := VerticalLayout {
                padding: Spacing.menu-pad;
                spacing: Spacing.xs;

                if root.context-menu-title != "": Text {
                    text: root.context-menu-title;
                    color: Theme.text-3;
                    font-size: Typography.label;
                    x: 4px;
                    width: parent.width - 8px;
                    overflow: elide;
                }

                MenuItem {
                    glyph: Glyph.paste;
                    text: "复制";
                    detail: "素材进剪贴板，绝不代发";
                    clicked => {
                        root.menu-action(0);
                    }
                }
                MenuItem {
                    glyph: Glyph.folder;
                    text: "移动到分类";
                    clicked => {
                        root.menu-action(1);
                    }
                }
                MenuItem {
                    glyph: Glyph.file-text;
                    text: "重命名";
                    clicked => {
                        root.menu-action(2);
                    }
                }
                MenuItem {
                    glyph: Glyph.info;
                    text: "属性";
                    clicked => {
                        root.menu-action(3);
                    }
                }
                // 危险动作独立分组（契约 §2.3）：红线 + danger 行，不和常规项混排。
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                // D90：主库视图 = 删除进回收站；空间视图 = 移出空间（副本直删，
                // 我的素材原件不动）。
                MenuItem {
                    glyph: Glyph.trash;
                    text: root.in-space-view ? "从空间移除" : "删除";
                    detail: root.in-space-view ? "只影响共享空间，我的素材不动" : "进回收站，可恢复";
                    danger: true;
                    clicked => {
                        root.menu-action(4);
                    }
                }
                // D90 拍板④：M0 直发默认隐藏，设置 direct-send-enabled 打开后
                // 出现（id=5 语义不变）。
                if root.direct-send-enabled: MenuItem {
                    glyph: Glyph.share;
                    text: "共享到设备…";
                    detail: "局域网直传";
                    clicked => {
                        root.menu-action(5);
                    }
                }
                // D90 共享空间：主库视图添加进空间（副本即落本地+广播）。
                if !root.in-space-view: MenuItem {
                    glyph: Glyph.share;
                    text: "添加到共享空间…";
                    detail: "同步给空间里的每位成员";
                    clicked => {
                        root.menu-action(7);
                    }
                }
                // D90：空间视图把副本存回我的素材（同一导入管线，内容等值自动去重）。
                if root.in-space-view: MenuItem {
                    glyph: Glyph.share;
                    text: "保存到我的素材";
                    detail: "复制一份到我的素材";
                    clicked => {
                        root.menu-action(8);
                    }
                }
            }
        }

        // —— 分类右键菜单（D84）：重命名 / 删除。删除语义 = 引用行归待分类
        //（category 置 NULL），素材与对象文件不动，可重新归类——因此不做
        // 二段确认（与瓦片「删除进回收站」同风险级）。样式同瓦片菜单浮层。
        if root.cat-menu-open: Rectangle {
            x: Math.min(root.cat-menu-x, root.width - 220px);
            y: Math.min(root.cat-menu-y, root.height - 140px);
            width: 220px;
            height: cat-menu-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            cat-menu-layout := VerticalLayout {
                padding: Spacing.menu-pad;
                spacing: Spacing.xs;

                if root.cat-menu-title != "": Text {
                    text: root.cat-menu-title;
                    color: Theme.text-3;
                    font-size: Typography.label;
                    x: 4px;
                    width: parent.width - 8px;
                    overflow: elide;
                }

                MenuItem {
                    glyph: Glyph.file-text;
                    text: "重命名";
                    clicked => {
                        root.cat-menu-action(0);
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                MenuItem {
                    glyph: Glyph.trash;
                    text: "删除";
                    detail: "素材移入待分类";
                    danger: true;
                    clicked => {
                        root.cat-menu-action(1);
                    }
                }
            }
        }

        // —— 「移动到分类」弹层：现有分类逐条 + 输入新名新建（统一归入同款交互）——
        if root.move-menu-open: Rectangle {
            x: Math.max(0px, (root.width - 280px) / 2);
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 280px;
            height: move-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            move-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: Spacing.sm;

                TitleLabel {
                    text: "移动到分类";
                }

                // 现有分类：横向滚动太挤，直接纵向列（分类数量级 <20）。
                // 高度必须显式钉值：内建 ScrollView 的 preferred 是 100%，在
                // 「弹层高度 = 布局 preferred」的弹层里循环依赖，会塌到内建
                // min-height(50px) 附近，列表只剩一条缝；钉 min(200px, 内容高)
                // 才能按内容展开、超过 200px 出滚动条。
                ScrollView {
                    height: Math.min(200px, move-cats.preferred-height);
                    viewport-width: self.visible-width;
                    viewport-height: move-cats.preferred-height;

                    move-cats := VerticalLayout {
                        spacing: 4px;
                        // 「全部」不是目的地，直接不实例化——visible:false 在
                        // Slint 布局里仍占一格（只藏不缩），会在视口顶端留空行。
                        // for 体不能直接接 if（parse error），包一层布局才上报
                        // preferred（裸包裹层会让整列 preferred 塌成 0）。
                        for name[i] in root.categories: VerticalLayout {
                            if i > 0: Rectangle {
                                height: Metrics.control;
                                border-radius: Theme.radius;
                                border-width: 1px;
                                border-color: move-cat-touch.has-hover ? Theme.accent : Theme.line;
                                background: move-cat-touch.has-hover ? Theme.bg-raised-hover : Theme.bg-raised;

                                Text {
                                    x: 10px;
                                    text: name;
                                    color: Theme.text-2;
                                    font-size: Typography.body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                move-cat-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        root.move-to-category(name);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.move-error != "": Text {
                    text: root.move-error;
                    color: Theme.danger;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 6px;
                    move-name := LineEdit {
                        placeholder-text: "输入新分类名即新建";
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "新建并移入";
                        primary: true;
                        clicked => {
                            root.move-to-category(move-name.text);
                        }
                    }
                }
            }
        }

        // —— D47/D46 底部操作条：多选与回收站两种形态 ——
        // 宽度自适应：窄窗口夹到窗宽-32px，按钮不再被挤出条外（D48 教训的补全）。
        if root.selection-bar != UiEnums.bar-hidden: Rectangle {
            y: root.height - self.height - 16px;
            x: (root.width - self.width) / 2;
            // D80 追加「共享」后 560px 装不下五个按钮，上限放宽到 620px。
            width: Math.min(620px, root.width - 32px);
            height: Metrics.bar;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            HorizontalLayout {
                // 条高 48、控件高 30：显式按交叉轴居中，否则默认 stretch 会把
                // 按钮顶在条的上沿（用户实拍反馈）。
                cross-axis-alignment: center;
                padding-left: Spacing.bar-pad;
                padding-right: Spacing.bar-pad;
                spacing: Spacing.md;

                Text {
                    text: root.selection-text;
                    color: Theme.text;
                    font-size: Typography.body;
                    font-weight: Typography.semibold;
                    vertical-alignment: center;
                    // 兜底：内容超宽时省略而非把按钮挤出条外（D48 实测教训）。
                    overflow: elide;
                    max-width: 240px;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // 高度统一钉 30px（与顶栏/侧栏控件同一档）；批量动作 0 选禁用——
                // 「已选 0 项」时可点删除只会得到一次空操作报错，禁用即说明。
                if root.selection-bar == UiEnums.bar-multi: Button {
                    height: Metrics.control;
                    text: "全选";
                    clicked => { root.select-all-requested(); }
                }
                if root.selection-bar == UiEnums.bar-multi: Button {
                    height: Metrics.control;
                    enabled: root.selection-count > 0;
                    text: "移动到分类";
                    clicked => { root.move-selection-requested(); }
                }
                // D90 共享入口：主库视图 = 添加到共享空间（与右键菜单
                // menu-action(7) 殊途同归，壳层同函数）；空间视图隐藏。
                if root.selection-bar == UiEnums.bar-multi && !root.in-space-view: Button {
                    height: Metrics.control;
                    enabled: root.selection-count > 0;
                    text: "共享";
                    clicked => { root.share-selection-requested(); }
                }
                if root.selection-bar == UiEnums.bar-multi: DangerButton {
                    height: Metrics.control;
                    enabled: root.selection-count > 0;
                    text: "删除";
                    clicked => { root.delete-selection-requested(); }
                }
                if root.selection-bar == UiEnums.bar-multi: Button {
                    height: Metrics.control;
                    text: "取消";
                    clicked => { root.select-mode-toggled(); }
                }

                if root.selection-bar == UiEnums.bar-trash: Button {
                    height: Metrics.control;
                    text: "全选";
                    clicked => { root.select-all-requested(); }
                }
                if root.selection-bar == UiEnums.bar-trash: Button {
                    height: Metrics.control;
                    enabled: root.selection-count > 0;
                    text: "恢复";
                    clicked => { root.restore-selection-requested(); }
                }
                if root.selection-bar == UiEnums.bar-trash: DangerButton {
                    height: Metrics.control;
                    enabled: root.selection-count > 0;
                    text: "彻底删除";
                    clicked => { root.purge-selection-requested(); }
                }
                if root.selection-bar == UiEnums.bar-trash: DangerButton {
                    height: Metrics.control;
                    text: root.empty-trash-text;
                    armed: root.empty-trash-armed;
                    clicked => { root.empty-trash-requested(); }
                }
            }
        }

        // —— D80 共享摘要条：在途/刚完结批次一句话列出（悬于操作条上方；——
        // 无操作条时也停在同位，不随 bar 形态跳位）。空串 = 无批次不渲染。
        if root.share-summary-text != "": Rectangle {
            property <length> text-max: 480px;
            y: root.height - self.height - 74px;
            x: (root.width - self.width) / 2;
            width: Math.min(summary-text.preferred-width + Spacing.huge, text-max + Spacing.huge);
            height: Metrics.row-compact;
            border-radius: self.height / 2;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.scrim;

            summary-text := Text {
                x: Spacing.xl;
                width: parent.width - Spacing.huge;
                text: root.share-summary-text;
                color: Theme.text-2;
                font-size: Typography.label;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // —— D80 设备选择弹窗（共享发送入口）：mDNS 扫描 + 单选 + 发送 ——
        if root.share-devices-open: Rectangle {
            x: (root.width - 340px) / 2;
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 340px;
            height: share-picker-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            share-picker-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 10px;

                TitleLabel {
                    text: "共享到设备";
                }

                // 设备列表：空态/扫描态文案，有设备逐行单选。
                if root.share-devices.length == 0: Text {
                    text: root.share-scan-busy ? "正在扫描局域网设备…" : "未发现设备——确认对方已打开本程序并接入同一局域网";
                    color: Theme.text-3;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }
                for device[i] in root.share-devices: Rectangle {
                    height: 40px;
                    border-radius: Theme.radius;
                    border-width: device.selected ? 1px : 0px;
                    border-color: Theme.accent;
                    background: device.selected ? Theme.accent-soft : Theme.bg-raised;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            spacing: Spacing.xxs;

                            Text {
                                text: device.name;
                                color: Theme.text;
                                font-size: Typography.body;
                                overflow: elide;
                            }
                            Text {
                                text: device.detail;
                                color: Theme.text-3;
                                font-size: Typography.caption;
                                overflow: elide;
                            }
                        }
                    }

                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.share-device-picked(i);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        height: Metrics.control;
                        text: "刷新";
                        enabled: !root.share-scan-busy;
                        clicked => { root.share-scan-requested(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        height: Metrics.control;
                        text: "取消";
                        clicked => { root.share-devices-closed(); }
                    }
                    Button {
                        height: Metrics.control;
                        primary: true;
                        enabled: root.share-selected-device >= 0;
                        text: "共享";
                        clicked => { root.share-confirm-requested(); }
                    }
                }
            }
        }

        // —— D80 首连确认弹窗（接收侧第一道门：确认后才暂存+导入）——
        if root.share-offer-open: Rectangle {
            x: (root.width - 340px) / 2;
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 340px;
            height: share-offer-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            share-offer-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 10px;

                TitleLabel {
                    text: "收到共享";
                }
                Text {
                    text: root.share-offer-text;
                    color: Theme.text-2;
                    font-size: Typography.body;
                    wrap: word-wrap;
                }
                Text {
                    text: "接收后素材将进入导入归类流程；数据经局域网点对点直传，不经任何中转服务器。";
                    color: Theme.text-3;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        height: Metrics.control;
                        text: "拒收";
                        clicked => { root.share-offer-reject(); }
                    }
                    Button {
                        height: Metrics.control;
                        primary: true;
                        text: "接收";
                        clicked => { root.share-offer-accept(); }
                    }
                }
            }
        }

        // —— D90「添加到共享空间」弹窗：行即空间，点哪加哪 ——
        // 副本立即落本地；在线成员即时收到，离线成员上线自动补齐（副本集）。
        if root.space-add-open: Rectangle {
            x: (root.width - 340px) / 2;
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 340px;
            height: space-add-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            space-add-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 10px;

                TitleLabel {
                    text: "添加到共享空间";
                }
                Text {
                    text: "素材会复制进空间并同步给每位成员；对方不在线也没关系，上线后自动收到。";
                    color: Theme.text-3;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                if root.space-add-rows.length == 0: Text {
                    text: root.space-add-hint;
                    color: Theme.text-3;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }
                for space in root.space-add-rows: Rectangle {
                    height: 36px;
                    border-radius: Theme.radius;
                    background: Theme.bg-raised;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        Text {
                            text: space.name;
                            color: Theme.text;
                            font-size: Typography.body;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: space.sub-label;
                            color: Theme.text-3;
                            font-size: Typography.caption;
                            vertical-alignment: center;
                        }
                        Button {
                            height: Metrics.row-compact;
                            primary: true;
                            text: "添加";
                            clicked => {
                                root.space-add-picked(space.id);
                            }
                        }
                    }
                }
                if root.space-add-rows.length == 0: HorizontalLayout {
                    spacing: 8px;

                    Button {
                        height: Metrics.control;
                        text: "创建共享空间…";
                        clicked => { root.space-manage-open-requested(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        height: Metrics.control;
                        text: "取消";
                        clicked => { root.space-add-closed(); }
                    }
                }
            }
        }

        // —— D90 共享空间管理弹窗：创建 + 清单 + 邀请码（唯一共享管理面）——
        // 心智模型（拍板：语义简单清晰）：空间 = 大家共用的素材柜，放进去的
        // 素材自动同步到每位成员电脑；不在线的成员上线后自动补齐。
        if root.space-ctl-open: Rectangle {
            x: (root.width - 420px) / 2;
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 420px;
            height: space-ctl-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            space-ctl-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 10px;

                TitleLabel {
                    text: "共享空间";
                }
                Text {
                    text: "共享空间像大家共用的素材柜：加进去的素材自动同步到每位成员的电脑，不在线也会在上线后收到，用起来和自己的素材完全一样。";
                    color: Theme.text-3;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                // 创建行：名字 + 创建（创建即进入空间视图，直接往里拖素材）。
                HorizontalLayout {
                    spacing: 8px;

                    LineEdit {
                        text <=> root.space-new-name;
                        placeholder-text: "新空间名称（如：团队素材）";
                        horizontal-stretch: 1;
                        accepted(text) => {
                            root.space-create(text);
                        }
                    }
                    Button {
                        height: Metrics.control;
                        primary: true;
                        text: "创建";
                        clicked => {
                            root.space-create(root.space-new-name);
                        }
                    }
                }

                // 加入行：贴同事给的邀请码（加入即进入，素材自动同步到本机）。
                HorizontalLayout {
                    spacing: 8px;

                    LineEdit {
                        text <=> root.space-join-code;
                        placeholder-text: "粘贴同事发来的邀请码";
                        horizontal-stretch: 1;
                        accepted(text) => {
                            root.space-join(text);
                        }
                    }
                    Button {
                        height: Metrics.control;
                        text: "加入";
                        clicked => {
                            root.space-join(root.space-join-code);
                        }
                    }
                }
                if root.space-ctl-error != "": InlineNotice { text: root.space-ctl-error; }
                if !root.space-ctl-ready: InlineNotice {
                    text: "共享引擎启动中，稍候片刻即可创建空间";
                }

                // 空间清单：行 = 名称 + 成员数 + 邀请码/退出。
                if root.space-rows.length == 0: Text {
                    text: "还没有共享空间。创建一个，把素材右键「添加到共享空间」，团队的素材库就一致了。";
                    color: Theme.text-3;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }
                for space in root.space-rows: Rectangle {
                    height: Metrics.control;
                    border-radius: Theme.radius;
                    background: Theme.bg-raised;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 8px;

                        Text {
                            text: space.name;
                            color: Theme.text;
                            font-size: Typography.body;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: space.sub-label;
                            color: Theme.text-3;
                            font-size: Typography.caption;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            height: Metrics.row-compact;
                            text: "邀请码";
                            clicked => { root.space-invite-copy(space.id); }
                        }
                        Button {
                            height: Metrics.row-compact;
                            text: "退出";
                            clicked => { root.space-leave(space.id); }
                        }
                    }
                }

                // 邀请码展示：只读可选中复制 + 重置（旧码即刻失效，拍板③：
                // 旋转机制保留，「重置」一个词对用户）。
                if root.space-ctl-invite != "": VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "空间邀请码（发给同事，对方点这里输入即可加入）";
                        color: Theme.text-2;
                        font-size: Typography.label;
                        font-weight: Typography.semibold;
                    }
                    LineEdit {
                        text: root.space-ctl-invite;
                        read-only: true;
                    }
                    HorizontalLayout {
                        spacing: 8px;

                        Button {
                            height: Metrics.row-compact;
                            text: "复制";
                            clicked => { root.space-invite-copy(root.space-ctl-invite-for); }
                        }
                        Button {
                            height: Metrics.row-compact;
                            text: "重置邀请码";
                            clicked => { root.space-invite-reset(root.space-ctl-invite-for); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        height: Metrics.control;
                        text: "关闭";
                        clicked => { root.space-ctl-closed(); }
                    }
                }
            }
        }



        // —— 重命名弹窗 ——
        if root.rename-open: Rectangle {
            x: (root.width - 340px) / 2;
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 340px;
            height: rename-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            rename-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 8px;

                TitleLabel {
                    text: "重命名";
                }

                rename-input := DialogInput {
                    text: root.rename-current;
                    placeholder-text: "新名称（只改显示名，不动磁盘路径）";
                    select-on-open: true;
                    accepted(text) => { root.rename-confirmed(text); }
                }

                if root.rename-error != "": Text {
                    text: root.rename-error;
                    color: Theme.danger;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "取消";
                        clicked => {
                            root.rename-canceled();
                        }
                    }
                    Button {
                        text: "保存";
                        primary: true;
                        clicked => {
                            root.rename-confirmed(rename-input.text);
                        }
                    }
                }
            }
        }

        // —— 分类重命名弹窗（D84）：只改分类名（引用该名的素材行批量跟随），
        // 不动素材文件名与磁盘路径。结构同素材重命名弹窗；独立弹窗不复用
        // rename-open——两者的确认路径不同（素材改名 vs 分类批量改写），
        // 共用弹窗要在确认处理器里判 pending 归属，分支比弹窗本身更贵。
        if root.cat-rename-open: Rectangle {
            x: (root.width - 340px) / 2;
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 340px;
            height: cat-rename-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            cat-rename-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 8px;

                TitleLabel {
                    text: "重命名分类";
                }

                cat-rename-input := DialogInput {
                    text: root.cat-rename-current;
                    placeholder-text: "新分类名";
                    select-on-open: true;
                    accepted(text) => { root.cat-rename-confirmed(text); }
                }

                if root.cat-rename-error != "": Text {
                    text: root.cat-rename-error;
                    color: Theme.danger;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "取消";
                        clicked => {
                            root.cat-rename-canceled();
                        }
                    }
                    Button {
                        text: "保存";
                        primary: true;
                        clicked => {
                            root.cat-rename-confirmed(cat-rename-input.text);
                        }
                    }
                }
            }
        }

        // —— 属性弹窗（R13：尺寸/大小/导入时间/绝对路径）——
        if root.properties-open: Rectangle {
            x: (root.width - 420px) / 2;
            y: Math.max(16px, (root.height - self.height) / 2);
            width: 420px;
            height: props-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            props-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    TitleLabel {
                        text: root.props-name;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                // 两列网格：左标签右值。空值（如视频无宽高）显示 —。
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "尺寸"; width: 70px; color: Theme.text-3; font-size: Typography.label; }
                        Text { text: root.props-size; horizontal-stretch: 1; color: Theme.text; font-size: Typography.label; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "大小"; width: 70px; color: Theme.text-3; font-size: Typography.label; }
                        Text { text: root.props-bytes; horizontal-stretch: 1; color: Theme.text; font-size: Typography.label; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "导入时间"; width: 70px; color: Theme.text-3; font-size: Typography.label; }
                        Text { text: root.props-created; horizontal-stretch: 1; color: Theme.text; font-size: Typography.label; }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "路径"; width: 70px; color: Theme.text-3; font-size: Typography.label; }
                        Text { text: root.props-path; horizontal-stretch: 1; color: Theme.text; font-size: Typography.label; wrap: word-wrap; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "打开所在文件夹"; clicked => { root.properties-folder-requested(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "关闭"; clicked => { root.properties-closed(); } }
                }
            }
        }

        // —— D70 新版本弹窗：应用内自更新（统一安装器路径——下载新
        // asset-installer → sha256 校验 → 本进程退出，安装器等信号后接管
        // 解包与重启）。「打开发布页」保留为回退出路。四态 = 初始（按钮组）/
        // 下载中（进度条+取消）/ 启动中（不可逆段，无按钮）/ 失败（错误行+
        // 重试）。两段式入场（同 classify）；Esc 在下载中 = 取消，其余照旧
        // 只关弹窗（D67 起点外部只挡不关）。
        if root.update-open: Rectangle {
            property <bool> shown: root.update-shown;
            property <bool> update-busy: root.update-downloading || root.update-launching;

            opacity: shown ? 1.0 : 0.0;
            x: (root.width - 400px) / 2;
            y: Math.max(16px, (root.height - self.height) / 2) + (shown ? 0px : 8px);
            width: 400px;
            height: update-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: Motion.enabled ? Motion.enter : 0ms; easing: ease-out; }

            update-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        commands: Glyph.export;
                        tint: Theme.accent;
                        width: 16px;
                        height: 16px;
                    }

                    TitleLabel {
                        text: "发现新版本 \{root.update-version}";
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                Text {
                    text: update-busy
                        ? "正在更新到 \{root.update-version}，完成后应用将自动重启"
                        : "当前版本 \{root.app-version} → 更新后 \{root.update-version}";
                    color: Theme.text-3;
                    font-size: Typography.label;
                }

                // notes 滚动区：高度钉 min(200px, 内容高)——不钉会塌成 ScrollView
                // 内建 min-height（「移动到分类」弹层同款坑，D48）；Text 包在
                // VerticalLayout 里让换行宽度跟随视口（裸 Text 在 ScrollView 里按
                // preferred 展开成单行）。
                if root.update-notes != "" && !update-busy: ScrollView {
                    height: Math.min(200px, update-notes-col.preferred-height);
                    viewport-width: self.visible-width;
                    viewport-height: update-notes-col.preferred-height;

                    update-notes-col := VerticalLayout {
                        Text {
                            text: root.update-notes;
                            color: Theme.text-2;
                            font-size: Typography.label;
                            wrap: word-wrap;
                        }
                    }
                }

                if root.update-apply-error != "": Text {
                    text: root.update-apply-error;
                    color: Theme.danger;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                if root.update-downloading: VerticalLayout {
                    spacing: 4px;

                    ProgressIndicator {
                        height: 4px;
                        progress: root.update-progress;
                    }

                    Text {
                        text: root.update-progress-text;
                        color: Theme.text-2;
                        font-size: Typography.label;
                    }
                }

                if root.update-launching: Text {
                    text: "校验通过，正在移交安装器，应用即将重启…";
                    color: Theme.text-2;
                    font-size: Typography.label;
                }

                if !update-busy: HorizontalLayout {
                    spacing: 8px;

                    FlatButton {
                        text: "跳过此版本";
                        tip: "以后启动不再提醒这个版本；手动检查仍会显示";
                        clicked => { root.update-skip-version(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "打开发布页";
                        enabled: root.update-url != "";
                        clicked => { root.update-open-release-page(); }
                    }

                    Button {
                        text: root.update-apply-error != "" ? "重试" : "立即更新";
                        primary: true;
                        clicked => { root.update-install-requested(); }
                    }
                }

                if root.update-downloading: HorizontalLayout {
                    spacing: 8px;

                    Rectangle { horizontal-stretch: 1; }

                    FlatButton {
                        text: "取消下载";
                        clicked => { root.update-cancel-install(); }
                    }
                }
            }
        }

        // D66 导入归类弹窗：居中卡片，行 = 来源组，三操作（归入/新建/待分类）。
        // 归入展开 = 检索框 + 候选列表（ScrollView 高度钉 min(166px, 内容高)
        // 整行裁齐防塌陷 + 防切行，update 弹窗同款坑）；新建展开 = 预填名输入。
        // 可解析包已由壳层静默直通（D66），不再有「按包内分类」操作项。入场
        // 下一帧翻转（shown 由壳层在 open 后置位），出场两段式（shown 先收、
        // open 延迟一拍收）。
        if root.classify-open: Rectangle {
            property <bool> shown: root.classify-shown;

            opacity: shown ? 1.0 : 0.0;
            y: Math.max(16px, (root.height - self.height) / 2) + (shown ? 0px : 8px);
            x: (root.width - self.width) / 2;
            width: 480px;
            height: classify-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: Motion.enabled ? Motion.enter : 0ms; easing: ease-out; }

            classify-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 10px;

                SectionLabel {
                    height: 14px;
                    text: "导入归类";
                }

                Text {
                    text: "输入分类名实时检索；点「导入」归入已有或新建同名分类，也可放入待分类。";
                    color: Theme.text-3;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                // 只读清单：本次导入的来源构成（批次级 = 决策只做一次，来源
                // 不再逐组成卡）。
                Text {
                    text: "本次导入：" + root.classify-summary;
                    color: Theme.text-3;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                classify-name-input := DialogInput {
                    height: Metrics.control;
                    text: root.classify-argument;
                    placeholder-text: "输入分类名，实时匹配已有分类…";
                    edited(text) => { root.classify-name-changed(text); }
                    accepted(text) => { root.classify-name-changed(text); }
                }

                // 候选列表：ScrollView 高度钉 min(178px, 内容高)，不钉会塌成
                // 内建 min-height（update 弹窗同款坑）。178px = 6 行整行裁齐
                // （行 28px + 间距 2px → 5 行 148px / 6 行 178px）——钉 150px
                // 会把第 6 行拦腰截断，文字切一半像渲染坏了；候选封顶 8 条
                // （MATCH_CAP），超出的靠列表内滚动，弹窗高度恒定。
                if root.classify-matches.length > 0: ScrollView {
                    height: Math.min(178px, matches-col.preferred-height);
                    viewport-width: self.visible-width;
                    viewport-height: matches-col.preferred-height;

                    matches-col := VerticalLayout {
                        spacing: Spacing.xxs;

                        for name in root.classify-matches: Rectangle {
                            height: Metrics.row-compact;
                            border-radius: Theme.radius;
                            background: name == root.classify-argument ? Theme.accent-soft
                                : (row-hover.has-hover ? Theme.bg-raised-hover : transparent);
                            row-hover := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.classify-picked(name); }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: name;
                                    color: name == root.classify-argument ? Theme.accent : Theme.text-2;
                                    font-size: Typography.label;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }

                // 实时预告行：导入前把结果说清楚（自动建分类不留无感知）。
                Text {
                    text: root.classify-hint;
                    color: root.classify-hint-kind == UiEnums.classify-hint-existing ? Theme.accent
                        : root.classify-hint-kind == UiEnums.classify-hint-new ? Theme.warn
                        : Theme.text-3;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }


                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "取消"; clicked => { root.classify-canceled(); } }
                    Button { text: "放入待分类"; clicked => { root.classify-confirmed(UiEnums.classify-confirm-inbox); } }
                    Button { text: "导入"; primary: true; clicked => { root.classify-confirmed(UiEnums.classify-confirm-resolve); } }
                }
            }
        }

        // D65 导入结果弹窗：跳过/相似/失败的持久逐项点名。D86 起与弹窗族
        // 统一水平+垂直居中（原先顶部锚定 y120）；行数超窗走 ScrollView（高度钉
        // min(320px, 内容高)，不钉会塌成内建 min-height——update 弹窗同款坑）。
        if root.import-result-open: Rectangle {
            property <bool> shown: root.import-result-shown;

            opacity: shown ? 1.0 : 0.0;
            x: (root.width - self.width) / 2;
            y: Math.max(16px, (root.height - self.height) / 2) + (shown ? 0px : 8px);
            width: 560px;
            height: result-layout.preferred-height;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.line-strong;
            background: Theme.bg-overlay;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.scrim;

            animate opacity, y { duration: Motion.enabled ? Motion.enter : 0ms; easing: ease-out; }

            result-layout := VerticalLayout {
                padding: Spacing.dialog-pad;
                spacing: 10px;

                SectionLabel {
                    height: 14px;
                    text: "导入结果";
                }

                Text {
                    text: root.import-result-summary;
                    color: Theme.text-2;
                    font-size: Typography.label;
                    wrap: word-wrap;
                }

                ScrollView {
                    height: Math.min(320px, result-rows.preferred-height);
                    viewport-width: self.visible-width;
                    viewport-height: result-rows.preferred-height;

                    result-rows := VerticalLayout {
                        spacing: 4px;

                        for row in root.import-result-rows: Rectangle {
                            height: 40px;
                            border-radius: Theme.radius;
                            background: Theme.bg-panel;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;

                                Rectangle {
                                    height: 18px;
                                    width: result-badge.preferred-width + Spacing.xxl;
                                    border-radius: self.height / 2;
                                    background: row.kind == UiEnums.result-row-failed ? Theme.danger-soft
                                        : row.kind == UiEnums.result-row-similar ? Theme.accent-soft
                                        : Theme.warn-soft;

                                    result-badge := Text {
                                        text: row.kind == UiEnums.result-row-failed ? "失败"
                                            : row.kind == UiEnums.result-row-similar ? "相似 " + row.distance
                                            : "完全相同";
                                        color: row.kind == UiEnums.result-row-failed ? Theme.danger
                                            : row.kind == UiEnums.result-row-similar ? Theme.accent
                                            : Theme.warn;
                                        font-size: Typography.label;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }

                                Text {
                                    text: row.source;
                                    color: Theme.text;
                                    font-size: Typography.label;
                                    font-weight: Typography.semibold;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 2;
                                }

                                Text {
                                    // failed 行右列 = 失败原因；exact 是字节等值（非相似，
                                    // 不带 ≈）；similar 才是相似提示。
                                    text: row.kind == UiEnums.result-row-failed ? row.existing
                                        : row.kind == UiEnums.result-row-exact ? "已有素材 " + row.existing
                                        : "≈ 已有素材 " + row.existing;
                                    color: Theme.text-3;
                                    font-size: Typography.label;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 3;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "知道了";
                        primary: true;
                        clicked => { root.import-result-closed(); }
                    }
                }
            }
        }
    }
        // Compact persistent entry; details survive expiration of the toast.
        HorizontalLayout {
            x: root.width - self.width - 16px;
            y: root.height - self.height - 12px;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: 8px;
            if root.import-result-available: Button {
                text: "导入明细";
                clicked => { root.import-result-requested(); }
            }
            if root.notice-history.length > 0: Button {
                text: "通知记录";
                clicked => { root.notice-history-open = !root.notice-history-open; }
            }
        }
        if root.notice-text != "" && !root.notice-history-open: ToastHost {
            x: root.width - self.width - 16px;
            y: root.height - self.height - 56px;
            width: Math.min(420px, root.width - 32px);
            text: root.notice-text;
            tone: root.notice-tone;
            changed hovered => { root.notice-hovered = self.hovered; }
            dismissed => { root.notice-hovered = false; root.notice-dismissed(); }
            history-requested => { root.notice-hovered = false; root.notice-history-open = true; }
        }
        if root.notice-history-open: NoticeHistory {
            x: root.width - self.width - 16px;
            y: root.height - self.height - 56px;
            width: Math.min(460px, root.width - 32px);
            height: Math.min(400px, root.height - 100px);
            rows: root.notice-history;
            closed => { root.notice-history-open = false; }
        }
    } // key-root FocusScope 收口
}
